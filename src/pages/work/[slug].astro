---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { u, skillColour } from '../../lib/url';

export async function getStaticPaths() {
  const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: work[(i + 1) % work.length] } }));
}
const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <article style={`--accent:${skillColour[d.skill]}`}>
    <header class="cs-head">
      <div class="halo" style="width:680px;height:420px;right:-160px;top:-60px;background:var(--accent);opacity:.28"></div>
      <div class="wrap">
        <a class="back label" href={u('/work/')}>← All work</a>
        <h1><i aria-hidden="true"></i>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <dl class="facts">
          <div><dt>Client</dt><dd>{d.client}</dd></div>
          <div><dt>Year</dt><dd>{d.year}</dd></div>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.link && <div><dt>Link</dt><dd><a href={d.link} rel="noopener">View live ↗</a></dd></div>}
        </dl>
      </div>
    </header>
    <div class={`wrap cover ${d.coverRatio}`}><img src={u(d.cover)} alt={d.title} /></div>
    <div class="wrap prose"><Content /></div>
    {d.gallery.length > 0 && (
      <div class={`wrap gallery ${d.coverRatio}`}>
        {d.gallery.map((g) => (
          <figure>
            <img src={u(g.image)} alt={g.caption || d.title} loading="lazy" decoding="async" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
    <nav class="wrap next">
      <p class="label">Next</p>
      <a href={u(`/work/${next.id}/`)}><span class="serif">{next.data.title}</span> <Arrow /></a>
    </nav>
  </article>
</Base>
<style>
  .cs-head { position: relative; padding: 170px 0 60px; overflow: hidden; }
  .back { display: inline-block; margin-bottom: 40px; color: var(--ink-3); }
  .back:hover { color: var(--peach); }
  .cs-head h1 { font-size: clamp(54px, 9vw, 124px); margin-bottom: 24px; position: relative; display: flex; align-items: center; gap: .22em; }
  .cs-head h1 i { flex: none; width: .14em; height: .14em; border-radius: 50%; background: var(--accent); box-shadow: 0 0 24px var(--accent); }
  .cs-head .lede { max-width: 40ch; position: relative; }
  .facts { display: flex; flex-wrap: wrap; gap: 20px 56px; margin: 44px 0 0; position: relative; }
  .facts dt { font: 500 11px/1 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 8px; }
  .facts dd { margin: 0; color: var(--ink); max-width: 40ch; }
  .cover img { width: 100%; border: 1px solid var(--line); box-shadow: 0 50px 140px -60px var(--accent); }
  .cover.portrait img { max-width: 560px; margin-inline: auto; }
  .prose { max-width: 760px; padding-block: 90px 40px; }
  .prose :global(h2) { font-size: clamp(32px, 4vw, 46px); margin: 56px 0 16px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { color: var(--ink-2); font-size: 18px; }
  .prose :global(strong) { color: var(--ink); font-weight: 500; }
  .prose :global(a) { color: var(--peach); border-bottom: 1px solid; }
  .gallery { display: grid; gap: 22px; padding-block: 40px 100px; }
  .gallery.landscape { grid-template-columns: 1fr 1fr; }
  .gallery.portrait { grid-template-columns: repeat(3, 1fr); }
  figure { margin: 0; }
  figure img { width: 100%; border: 1px solid var(--line); }
  figcaption { font: italic 17px/1.3 var(--serif); color: var(--ink-3); margin-top: 10px; }
  .next { border-top: 1px solid var(--line); padding-block: 50px 120px; }
  .next a { display: inline-flex; align-items: center; gap: 18px; }
  .next .serif { font-size: clamp(38px, 6vw, 72px); transition: color .3s; }
  .next a:hover .serif { color: var(--peach); }
  .next :global(svg) { width: 34px; height: 18px; }
  @media (max-width: 760px) { .gallery.landscape, .gallery.portrait { grid-template-columns: 1fr; } .gallery.portrait { grid-template-columns: 1fr 1fr; } }
</style>
