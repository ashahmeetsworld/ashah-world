---
// The work (20 Nov 2026, mock-up Work C "The reel", Ashah's pick): no subtitle, tabs All / Brand Identity / Art Direction / Creative Strategy
// (from each entry's `category`), one piece per row, sides swap, each cover glows in its own colour (`glow`, else its skill colour).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { u, skillColour } from '../../lib/url';
import { LIVE_FROM_INSTAGRAM } from '../../lib/live';
import { CARD_COVER } from '../../lib/cards';
const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const CATS = ['Brand Identity', 'Art Direction', 'Creative Strategy'].filter((c) => work.some((w) => w.data.category === c));
const tabs = ['All', ...CATS];
---
<Base bare title="Work" description="Selected work by Ashah Meets World: creative direction, worldbuilding and content systems.">
  <section class="ph">
    <div class="stars" aria-hidden="true"></div>
    <div class="wrap row">
      <h1>The work.</h1>
      <div class="tabs" role="tablist" aria-label="Filter the work">
        {tabs.map((t, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'on' : ''} data-cat={t}>{t}</button>)}
      </div>
    </div>
    <div class="hz" aria-hidden="true"></div>
  </section>
  <section class="wrap reel">
    {work.map((w, i) => {
      const d = w.data;
      const cover = CARD_COVER[w.id] ?? d.cover;
      const tall = d.coverRatio === 'portrait' && !CARD_COVER[w.id];
      const live = LIVE_FROM_INSTAGRAM.includes(w.id) && !CARD_COVER[w.id] && site.instagramFeedUrl;
      return (
        <a class={`r${i % 2 ? ' flip' : ''}${i === work.length - 1 ? ' last' : ''}`} href={u(`/work/${w.id}/`)} data-cat={d.category ?? ''} style={`--c:${d.glow || skillColour[d.skill]}`}>
          <div class={`fr${tall ? ' tall' : ''}`}>
            {d.wip && <span class="wip">Work in Progress</span>}
            {tall && <span class="bl" style={`background-image:url('${u(cover)}')`}></span>}
            <img src={u(cover)} alt={d.title} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" data-live-cover={live || undefined} />
          </div>
          <div class="tx">
            {d.category && <div class="lb"><i></i>{d.category}</div>}
            <h3>{d.title}</h3>
            <p>{d.summary}</p>
          </div>
        </a>
      );
    })}
  </section>
</Base>
<script>
  import { loadFeed, carousels, slidesOf } from '../../lib/feed';
  // tabs: show one category; rows keep swapping sides in the order they're shown
  const tabs = document.querySelectorAll<HTMLButtonElement>('.ph .tabs button');
  const rows = [...document.querySelectorAll<HTMLElement>('.reel .r')];
  tabs.forEach((b) => b.addEventListener('click', () => {
    tabs.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
    let k = 0;
    let lastShown: HTMLElement | null = null;
    rows.forEach((r) => {
      const show = b.dataset.cat === 'All' || r.dataset.cat === b.dataset.cat;
      r.hidden = !show;
      r.classList.remove('last');
      if (show) { r.classList.toggle('flip', k % 2 === 1); r.classList.remove('in'); void r.offsetWidth; r.classList.add('in'); k++; lastShown = r; }
    });
    lastShown?.classList.add('last');
  }));
  // Field Notes: first slide of the latest Field Notes carousel, live from Instagram
  document.querySelectorAll<HTMLImageElement>('img[data-live-cover]').forEach(async (img) => {
    try {
      const latest = carousels(await loadFeed(img.dataset.liveCover!))[0];
      const src = latest && slidesOf(latest)[0];
      if (!src) return;
      img.src = src;
      const bl = img.parentElement?.querySelector<HTMLElement>('.bl');
      if (bl) bl.style.backgroundImage = `url('${src}')`;
    } catch { /* keep the cover that shipped with the page */ }
  });
</script>
<style>
  .ph { position: relative; padding: 190px 0 64px; overflow: hidden; }
  .stars { position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(1.2px 1.2px at 8% 22%, #fffa, transparent), radial-gradient(1px 1px at 18% 64%, #fff8, transparent), radial-gradient(1px 1px at 27% 14%, #fff9, transparent), radial-gradient(1.4px 1.4px at 39% 48%, #fff7, transparent), radial-gradient(1px 1px at 52% 26%, #fff6, transparent), radial-gradient(1px 1px at 63% 58%, #fff7, transparent), radial-gradient(1.2px 1.2px at 74% 18%, #fff8, transparent), radial-gradient(1px 1px at 86% 40%, #fff6, transparent), radial-gradient(1px 1px at 93% 70%, #fff7, transparent); }
  .row { position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  h1 { font-size: 104px; line-height: .95; margin: 0; }
  .tabs { display: flex; padding: 5px; border-radius: 999px; background: rgba(12, 16, 48, .7); border: 1px solid rgba(159, 182, 236, .28); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05); margin-bottom: 12px; }
  .tabs button { font: inherit; border: 0; background: none; cursor: pointer; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #C9CFEA; padding: 13px 22px; border-radius: 999px; transition: color .4s, background .4s, box-shadow .4s; white-space: nowrap; }
  .tabs button:hover { color: var(--ink); }
  .tabs button.on { color: #06081A; font-weight: 600; background: linear-gradient(90deg, #8FB3F6, #9EA1FB 50%, #A498FE 75%, #B49AE9); box-shadow: 0 0 22px rgba(127, 216, 240, .5), 0 0 50px rgba(169, 150, 255, .3); }
  .hz { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(127, 216, 240, .55) 30%, rgba(255, 243, 224, .95) 50%, rgba(169, 150, 255, .55) 70%, transparent); }
  .hz::before { content: ''; position: absolute; left: 50%; top: -110px; width: 900px; height: 220px; margin-left: -450px; background: radial-gradient(ellipse at 50% 50%, rgba(169, 150, 255, .28), rgba(127, 216, 240, .10) 40%, transparent 70%); animation: hzb 8s ease-in-out infinite; opacity: .85; }
  @keyframes hzb { 50% { opacity: 1; transform: scale(1.06); } }
  .reel { padding-bottom: 40px; }
  .r { display: grid; grid-template-columns: 7fr 5fr; gap: 64px; align-items: center; padding: 72px 0; border-bottom: 1px solid var(--line); color: inherit; }
  .r.last { border-bottom: 0; }
  .r[hidden] { display: none; }
  .r.flip { grid-template-columns: 5fr 7fr; }
  .r.flip .fr { order: 2; }
  .r.in { animation: rin .7s ease-out; }
  @keyframes rin { from { opacity: 0; transform: translateY(12px); } }
  .fr { position: relative; overflow: hidden; aspect-ratio: 16 / 9; background: #05071A; border-radius: 6px; border: 1px solid var(--line); box-shadow: 0 40px 100px -50px var(--c); transition: box-shadow .6s; }
  .fr img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.4s var(--ease); }
  .fr.tall img { object-fit: contain; }
  .wip { position: absolute; top: 18px; left: 18px; z-index: 3; font-size: 12px; padding: 7px 13px 7px 15px; display:inline-flex;align-items:center;padding:8px 16px 8px 18px;border-radius:999px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;line-height:1.2;letter-spacing:.34em;text-transform:uppercase;white-space:nowrap;color:#fff;background:linear-gradient(100deg,rgba(127,216,240,.22),rgba(169,150,255,.22)),rgba(7,10,28,.55);box-shadow:inset 0 0 0 1px rgba(207,230,255,.45),0 0 24px rgba(127,216,240,.28),0 0 50px rgba(169,150,255,.18);text-shadow:0 0 12px rgba(207,230,255,.8);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:wipGlow 4s ease-in-out infinite}
  @keyframes wipGlow{50%{box-shadow:inset 0 0 0 1px rgba(207,230,255,.6),0 0 34px rgba(127,216,240,.45),0 0 70px rgba(169,150,255,.28)}}
  .fr .bl { position: absolute; inset: -30px; background: center / cover; filter: blur(28px) saturate(1.3) brightness(.55); }
  .r:hover .fr { box-shadow: 0 50px 120px -40px var(--c); }
  .r:hover .fr img { transform: scale(1.03); }
  .lb { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #FFF3E0; display: flex; align-items: center; gap: 12px; }
  .lb i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c), 0 0 26px var(--c); }
  .tx h3 { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 54px; line-height: 1.02; margin: 22px 0 18px; transition: color .3s; }
  .r:hover h3 { color: var(--peach); }
  .tx p { font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 42ch; margin: 0; }
  @media (max-width: 1100px) { .row { flex-direction: column; align-items: flex-start; gap: 30px; } .tabs { margin: 0; } }
  @media (max-width: 760px) {
    .ph { padding: 130px 0 40px; }
    h1 { font-size: 64px; }
    .tabs { display: grid; grid-template-columns: 1fr 1fr; border-radius: 22px; width: 100%; }
    .tabs button { text-align: center; padding: 12px 0; font-size: 10px; letter-spacing: .18em; }
    .r, .r.flip { grid-template-columns: 1fr; gap: 24px; padding: 44px 0; }
    .r.flip .fr { order: 0; }
    .tx h3 { font-size: 38px; margin: 14px 0 12px; }
    .tx p { font-size: 15px; }
  }
</style>
