---
// The Session page (v1.1, 19 Nov 2026): desktop shows the night-scenes layout (C), phone shows the
// glowing-path layout (A); both carry the same words. Generated by src/session/build.py
// (python3 src/session/build.py src/session __BASE__), assets in public/home/.
import html from '../session/session.html?raw';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const out = html.replace(/^<!doctype html>/i, '').replaceAll('__BASE__', base);
---
<Fragment set:html={out} />
