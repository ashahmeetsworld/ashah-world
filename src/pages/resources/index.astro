---
// Resources (Ashah, 20 Nov 2026): a heading, then the six workbook cards from the home page, in the work pages' current look.
// Each card glows in its own workbook's colour (same values as resources/[slug].astro). Links: home top right + work pages' footer.
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
const W = [
  { slug: 'identity', name: 'Identity', line: 'Everyone sells something. Few know who they are.', glow: '242,207,154' },
  { slug: 'storytelling', name: 'Storytelling', line: 'The craft is there. Now let the story show it.', glow: '185,164,255' },
  { slug: 'product', name: 'Product', line: 'People buy the feeling. Make the product the door.', glow: '242,164,122' },
  { slug: 'ecosystem', name: 'Ecosystem', line: 'Every place they meet you should feel like one world.', glow: '95,227,208' },
  { slug: 'continuity', name: 'Continuity', line: 'Hype lasts a week. A world lasts for years.', glow: '232,140,150' },
  { slug: 'campaigns', name: 'Campaigns', line: 'Build the wait. Make the drop a moment.', glow: '91,227,142' },
];
---
<Base bare title="Resources" description="Free workbooks for building a brand people step into.">
  <section class="ph">
    <div class="stars" aria-hidden="true"></div>
    <div class="wrap"><h1>Resources.</h1></div>
    <div class="hz" aria-hidden="true"></div>
  </section>
  <section class="wrap shelf">
    {W.map((w, i) => (
      <a class="tl" href={u(`/resources/${w.slug}/`)} style={`--c:${w.glow}`}>
        <div class="im"><img src={u(`/home/wb-${w.slug}.webp`)} alt={`${w.name} Workbook cover`} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" /></div>
        <div class="in">
          <h3>{w.name} Workbook</h3>
          <p>{w.line}</p>
          <span class="go">Get it free →</span>
        </div>
      </a>
    ))}
  </section>
</Base>
<style>
  .ph { position: relative; padding: 190px 0 64px; overflow: hidden; }
  .stars { position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(1.2px 1.2px at 8% 22%, #fffa, transparent), radial-gradient(1px 1px at 18% 64%, #fff8, transparent), radial-gradient(1px 1px at 27% 14%, #fff9, transparent), radial-gradient(1.4px 1.4px at 39% 48%, #fff7, transparent), radial-gradient(1px 1px at 52% 26%, #fff6, transparent), radial-gradient(1px 1px at 63% 70%, #fff8, transparent), radial-gradient(1.3px 1.3px at 74% 18%, #fffa, transparent), radial-gradient(1px 1px at 86% 52%, #fff7, transparent), radial-gradient(1px 1px at 94% 30%, #fff9, transparent); opacity: .7; }
  h1 { position: relative; font-size: 104px; line-height: .95; margin: 0; }
  .hz { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(127, 216, 240, .55) 30%, rgba(255, 243, 224, .95) 50%, rgba(169, 150, 255, .55) 70%, transparent); }
  .hz::before { content: ''; position: absolute; left: 50%; top: -110px; width: 900px; height: 220px; margin-left: -450px; background: radial-gradient(ellipse at 50% 50%, rgba(169, 150, 255, .28), rgba(127, 216, 240, .10) 40%, transparent 70%); animation: hzb 8s ease-in-out infinite; opacity: .85; }
  @keyframes hzb { 50% { opacity: 1; transform: scale(1.06); } }
  .shelf { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px 32px; padding-top: 80px; padding-bottom: 120px; }
  .tl { display: block; color: inherit; border-radius: 6px; overflow: hidden; border: 1px solid var(--line); background: #0C1030; box-shadow: 0 40px 90px -55px rgb(var(--c)); transition: box-shadow .6s, border-color .6s; }
  .im { aspect-ratio: 16 / 9; overflow: hidden; background: #05071A; }
  .im img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.4s var(--ease); }
  .in { padding: 26px 28px 30px; }
  h3 { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 34px; line-height: 1.05; margin: 0 0 10px; transition: color .3s; }
  .in p { font-size: 15px; line-height: 1.55; color: var(--ink-2); margin: 0; min-height: 3.1em; }
  .go { display: inline-block; margin-top: 20px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #FFF3E0; }
  .tl:hover { border-color: rgba(var(--c), .45); box-shadow: 0 50px 110px -45px rgb(var(--c)); }
  .tl:hover .im img { transform: scale(1.04); }
  .tl:hover h3 { color: rgb(var(--c)); }
  @media (max-width: 1100px) { .shelf { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .ph { padding: 130px 0 40px; }
    h1 { font-size: 64px; }
    .shelf { grid-template-columns: 1fr; gap: 28px; padding-top: 44px; padding-bottom: 80px; }
    h3 { font-size: 30px; }
    .in { padding: 22px 22px 26px; }
    .in p { min-height: 0; }
  }
</style>
