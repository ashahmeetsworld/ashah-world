---
// Hidden 17 Oct 2026 (the underscore stops Astro building it). Rename back to community.astro to republish.
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Fireflies from '../components/Fireflies.astro';
import Constellation from '../components/Constellation.astro';
import Signup from '../components/Signup.astro';
import c from '../data/community.json';
import site from '../data/site.json';
import { u } from '../lib/url';
---
<Base title="Community" description={c.intro}>
  <section class="c-hero">
    <Fireflies />
    <div class="c-fade"></div>
    <div class="wrap c-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
      <p class="intro">{c.intro}</p>
      <div class="ctas">
        <a class="btn ember" href="#join"><span>Stay close</span></a>
        <a class="go" href={u('/contact/')}>Open a door <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="pad lead-sec">
    <div class="wrap lead">
      <div class="lead-copy rv">
        <p class="eyebrow">{c.leadEyebrow}</p>
        <h2>{c.leadTitle}</h2>
        <p class="body">{c.leadText}</p>
        <div class="roles">
          {c.roles.map((r, i) => (
            <div class="role" style={`--i:${i}`}>
              <h3>{r.name}</h3>
              <p>{r.line}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="lead-art rv"><Constellation talent={c.talent} /></div>
    </div>
  </section>

  <section class="pad ethos-sec">
    <div class="wrap">
      <div class="head rv">
        <p class="eyebrow">{c.ethosEyebrow}</p>
        <h2>{c.ethosTitle}</h2>
        <p class="body">{c.ethosText}</p>
      </div>
      <ol class="ethos">
        {c.ethos.map((e, i) => (
          <li class="rv" style={`--i:${i}`}>
            <span class="pd" aria-hidden="true"></span>
            <h3 class="serif">{e.title}</h3>
            <div class="e-body">
              <p>{e.text}</p>
              <p class="practice">{e.practice}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pad">
    <div class="wrap">
      <div class="head rv">
        <p class="eyebrow">{c.pocketsEyebrow}</p>
        <h2>{c.pocketsTitle}</h2>
        <p class="body">{c.pocketsText}</p>
      </div>
      <div class="pockets">
        {c.pockets.map((p, i) => (
          <div class="pocket rv" style={`transition-delay:${(i % 4) * 70}ms`}>
            <span class="dot" aria-hidden="true"></span>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad join" id="join">
    <div class="wrap">
      <div class="panel rv">
        <div class="j-glow" aria-hidden="true"></div>
        <svg class="j-tinsel" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 300 C 200 270, 380 330, 600 296 S 1000 262, 1200 292" />
          <path d="M0 322 C 220 300, 420 352, 640 318 S 1020 290, 1200 316" />
          <path d="M0 346 C 240 330, 460 372, 680 342 S 1040 318, 1200 340" />
          <path d="M0 368 C 260 356, 480 392, 720 366 S 1060 346, 1200 364" />
        </svg>
        <div class="j-copy">
          <p class="eyebrow">Stay close</p>
          <h2>{c.joinTitle}</h2>
          <p class="body">{c.joinText}</p>
        </div>
        <div class="ways">
          <div class="way">
            <p class="label">The Discord</p>
            {site.discordUrl
              ? <a class="go glow" href={site.discordUrl} rel="noopener">Join the Discord <Arrow /></a>
              : <p class="soon serif">Doors opening soon.</p>}
          </div>
          <Signup title="Letters from the world" text="What I'm learning and making, invitations, and the Discord invite when the doors open." />
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .c-hero { position: relative; min-height: 92svh; display: grid; align-items: center; overflow: hidden; padding: 150px 0 120px; }
  .c-fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 11, 24, .25), transparent 40%, transparent 75%, var(--midnight) 100%); pointer-events: none; }
  .c-copy { position: relative; max-width: 760px; margin-inline: auto; text-align: center; display: grid; justify-items: center; }
  .c-copy .eyebrow { color: #FFC27A; text-shadow: 0 0 18px rgba(255, 150, 60, .6); }
  .c-hero h1 { font-size: clamp(54px, 9vw, 128px); margin-bottom: 22px; text-shadow: 0 0 60px rgba(242, 180, 140, .25); }
  .c-hero .lede { max-width: 32ch; margin: 0 0 22px; color: var(--ink); }
  .intro { color: var(--ink-2); max-width: 58ch; margin: 0 0 32px; }
  /* ember aurora button: amber, orange and red drifting, with a streak of tinsel */
  .btn.ember { position: relative; overflow: hidden; isolation: isolate; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; color: #1A0805; border: 0;
    background: linear-gradient(110deg, #FFC062, #FF8A3D 30%, #F0524F 55%, #FF8A3D 78%, #FFD08A); background-size: 250% 100%;
    box-shadow: 0 0 30px rgba(255, 138, 61, .32), 0 0 60px rgba(240, 82, 79, .2); animation: em-btn 8s ease-in-out infinite alternate; transition: box-shadow .4s; }
  .btn.ember span { position: relative; z-index: 1; }
  .btn.ember::after { content: ''; position: absolute; inset: 0; z-index: 0; background: linear-gradient(100deg, transparent 35%, rgba(255, 245, 225, .6) 50%, transparent 65%); transform: translateX(-120%); animation: em-tin 5s ease-in-out infinite 1.5s; }
  .btn.ember:hover { box-shadow: 0 0 46px rgba(255, 138, 61, .55), 0 0 90px rgba(240, 82, 79, .32); }
  @keyframes em-btn { to { background-position: 100% 0; } }
  @keyframes em-tin { 0% { transform: translateX(-120%); } 35%, 100% { transform: translateX(120%); } }
  .ctas { align-items: center; }
  .ctas { display: flex; gap: 14px 34px; flex-wrap: wrap; justify-content: center; }

  .head { max-width: 720px; margin-bottom: clamp(40px, 5vw, 64px); }
  .head h2 { margin-bottom: 18px; }
  .pockets { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pocket { position: relative; padding: 28px 24px 26px; border: 1px solid var(--line); background: rgba(20, 11, 34, .35); overflow: hidden; }
  .pocket::before { content: ''; position: absolute; width: 180px; height: 180px; right: -70px; top: -70px; border-radius: 50%; background: radial-gradient(circle, rgba(242, 180, 140, .2), transparent 70%); }
  .pocket .dot { display: block; width: 8px; height: 8px; border-radius: 50%; background: #FFE3B8; box-shadow: 0 0 14px #F2B48C, 0 0 30px rgba(216, 42, 153, .6); margin-bottom: 18px; animation: sync 3.2s ease-in-out infinite; }
  @keyframes sync { 0%, 60%, 100% { opacity: .35; } 70% { opacity: 1; } }
  .pocket h3 { font-size: 30px; margin-bottom: 8px; }
  .pocket p { margin: 0; color: var(--ink-2); font-size: 15px; }


  .panel { position: relative; overflow: hidden; isolation: isolate; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; padding: clamp(28px, 5vw, 56px);
    border: 1px solid transparent; background: linear-gradient(160deg, #170B0C, #0B0810 65%) padding-box, linear-gradient(120deg, rgba(255, 192, 98, .75), rgba(255, 138, 61, .4) 40%, rgba(240, 82, 79, .6) 75%, rgba(255, 192, 98, .3)) border-box; }
  .j-copy, .ways { position: relative; z-index: 1; }
  .j-glow { position: absolute; inset: -30% -10%; z-index: 0; pointer-events: none; filter: blur(40px);
    background:
      radial-gradient(40% 55% at 82% 25%, rgba(255, 176, 80, .2), transparent 70%),
      radial-gradient(45% 60% at 95% 75%, rgba(240, 82, 79, .2), transparent 70%),
      radial-gradient(40% 50% at 12% 10%, rgba(216, 42, 106, .16), transparent 70%),
      radial-gradient(50% 40% at 30% 100%, rgba(255, 120, 50, .14), transparent 70%);
    animation: j-au 16s ease-in-out infinite alternate; }
  @keyframes j-au { 50% { transform: translate3d(-4%, 3%, 0) skewX(-4deg); opacity: .7; } 100% { transform: translate3d(3%, -2%, 0) skewX(3deg); opacity: 1; } }
  .j-tinsel { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 38%; z-index: 0; pointer-events: none; }
  .j-tinsel path { fill: none; stroke-width: 1.2; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 3 9; animation: j-tin 6s linear infinite; filter: drop-shadow(0 0 4px rgba(255, 150, 60, .75)); }
  .j-tinsel path:nth-child(1) { stroke: #F0524F; opacity: .35; }
  .j-tinsel path:nth-child(2) { stroke: #FF8A3D; opacity: .45; animation-duration: 8s; animation-direction: reverse; }
  .j-tinsel path:nth-child(3) { stroke: #FFC062; opacity: .55; animation-duration: 7s; }
  .j-tinsel path:nth-child(4) { stroke: #FFD9A0; opacity: .4; animation-duration: 10s; animation-direction: reverse; }
  @keyframes j-tin { to { stroke-dashoffset: -120; } }
  .panel .eyebrow, .way .label { color: #FFC27A; }
  .panel :global(input) { background: rgba(11, 8, 16, .85); }
  .panel :global(.btn) { position: relative; overflow: hidden; color: #1A0805; border: 0; background: linear-gradient(110deg, #FFC062, #FF8A3D 30%, #F0524F 55%, #FF8A3D 78%, #FFD08A); background-size: 250% 100%; box-shadow: 0 0 26px rgba(255, 138, 61, .3); animation: em-btn 8s ease-in-out infinite alternate; }
  .panel :global(.btn:hover) { color: #1A0805; box-shadow: 0 0 46px rgba(255, 138, 61, .55), 0 0 90px rgba(240, 82, 79, .32); }
  .panel h2 { margin-bottom: 16px; }
  .ways { display: grid; gap: 30px; }
  .way { padding-bottom: 26px; border-bottom: 1px solid var(--line); }
  .way .label { margin: 0 0 10px; }
  .soon { margin: 0; font-size: 26px; color: var(--ink-2); }
  .pd { display: block; width: 10px; height: 10px; border-radius: 50%; background: #FFE3B8; box-shadow: 0 0 14px #F2B48C, 0 0 30px rgba(216, 42, 153, .6); animation: sync 3.2s ease-in-out infinite; }
  .panel .body { margin: 0; }

  .lead-sec { background: radial-gradient(55% 60% at 75% 50%, rgba(216, 42, 153, .1), transparent 70%); }
  .lead { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(30px, 6vw, 90px); align-items: center; }
  .lead-copy h2 { margin-bottom: 20px; }
  .lead-copy .body { margin: 0 0 34px; }
  .roles { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid rgba(242, 180, 140, .3); }
  .role { padding: 22px 22px 0 0; }
  .role + .role { padding-left: 22px; border-left: 1px solid var(--line); }
  .role h3 { font-size: 30px; margin-bottom: 8px; color: #FFE7CF; }
  .role p { margin: 0; color: var(--ink-2); font-size: 15px; }

  .ethos-sec { background: radial-gradient(60% 50% at 20% 40%, rgba(138, 76, 142, .14), transparent 70%); }
  .ethos { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .ethos li { display: grid; grid-template-columns: 26px minmax(0, 1fr) minmax(0, 1.15fr); gap: 10px clamp(20px, 4vw, 60px); align-items: baseline; padding: clamp(24px, 3vw, 36px) 0; border-bottom: 1px solid var(--line); }
  .ethos .pd { margin: 0; align-self: center; animation-delay: calc(var(--i) * .45s); }
  .ethos h3 { font-size: clamp(30px, 3.6vw, 46px); margin: 0; transition: color .4s, text-shadow .4s; }
  .ethos li:hover h3 { color: #FFE7CF; text-shadow: 0 0 30px rgba(242, 180, 140, .45); }
  .e-body p { margin: 0; color: var(--ink-2); }
  .e-body .practice { margin-top: 12px; font: 500 11px/1.6 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: #FFB98A; }

  @media (max-width: 980px) { .pockets { grid-template-columns: 1fr 1fr; } .lead { grid-template-columns: 1fr; } .lead-art { max-width: 560px; margin-inline: auto; width: 100%; } }
  @media (max-width: 760px) { .panel { grid-template-columns: 1fr; } .pockets, .roles { grid-template-columns: 1fr; } .role + .role { padding-left: 0; border-left: 0; } .ethos li { grid-template-columns: 22px 1fr; } .e-body { grid-column: 2; } }
</style>
