---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import site from '../data/site.json';
import SocialIcons from '../components/SocialIcons.astro';
const socials = site.socials.filter((s) => s.url);
---
<Base title="Contact" description="Collabs, freelance projects, questions or just hello. Ashah Meets World, Melbourne.">
  <section class="c-wrap">
    <div class="halo" style="width:620px;height:480px;right:-140px;top:-60px;background:var(--violet);opacity:.6"></div>
    <div class="halo" style="width:420px;height:320px;left:-120px;bottom:10%;background:var(--sapphire);opacity:.45"></div>
    <div class="wrap grid">
      <div class="intro">
        <p class="eyebrow">Contact</p>
        <h1>Open the door.</h1>
        <p class="lede">Collabs, freelance projects, a question, or just hello. Tell me what you’re building and I’ll come back within a few days.</p>
        <div class="direct">
          {site.email && <p><span class="label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></p>}
          {site.bookingUrl && <p><span class="label">Book</span><a href={site.bookingUrl} rel="noopener">A 15–20 min discovery call ↗</a></p>}
          {site.discordUrl && <p><span class="label">Community</span><a href={site.discordUrl} rel="noopener">Join the Discord ↗</a></p>}
          {socials.length > 0 && <div class="else"><span class="label">Elsewhere</span><SocialIcons /></div>}
          <p><span class="label">Based in</span><span>{site.location}</span></p>
        </div>
      </div>
      <div class="form-panel">
        {site.contactFormEmbed ? (
          <div class="embed" set:html={site.contactFormEmbed} />
        ) : (
          <form id="contact-form" action={site.contactFormUrl || (site.email ? `mailto:${site.email}` : undefined)} method="post" enctype={site.contactFormUrl ? undefined : 'text/plain'}>
            {site.contactFormUrl && <input type="hidden" name="_subject" value="New enquiry · Ashah Meets World" />}
            <label class="field"><span>Name</span><input id="f-name" name="name" autocomplete="name" required /></label>
            <label class="field"><span>Email</span><input id="f-email" name="email" type="email" autocomplete="email" required /></label>
            <label class="field"><span>Brand or project</span><input id="f-brand" name="brand" placeholder="Label, artist, collective…" /></label>
            <label class="field"><span>What is it about?</span>
              <select id="f-type" name="type">
                <option>Collab</option>
                <option>Freelance project</option>
                <option>A question</option>
                <option>Just saying hello</option>
              </select>
            </label>
            <label class="field"><span>What are you working on?</span><textarea id="f-message" name="message" placeholder="The drop, the vision, the timeline…"></textarea></label>
            <button class="btn aurora" id="f-send" type="submit" disabled={!site.contactFormUrl && !site.email}><span>Send it into the world</span></button>
            {!site.contactFormUrl && !site.email && <p class="note">The form goes live once a form link (or an email) is set in site settings.</p>}
            <p class="note status" role="status" aria-live="polite"></p>
          </form>
        )}
      </div>
    </div>
  </section>
  <!-- Letters from the world: a soft dusk glow, like the fireflies, so the list feels like part of the community -->
  <section class="news">
    <div class="halo" style="width:640px;height:420px;left:-120px;top:60px;background:var(--mauve);opacity:.26"></div>
    <div class="halo" style="width:420px;height:280px;left:12%;top:170px;background:#C2605A;opacity:.16"></div>
    <div class="wrap"><hr class="rule" /><div class="news-in"><Signup /></div></div>
  </section>
</Base>
<script>
  // Send without leaving the page (Formspree answers JSON when asked).
  const f = document.getElementById('contact-form') as HTMLFormElement | null;
  if (f && f.action.includes('formspree.io')) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = f.querySelector('button') as HTMLButtonElement;
      const status = f.querySelector('.status') as HTMLElement;
      btn.disabled = true; btn.querySelector('span')!.textContent = 'Sending…';
      try {
        const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error();
        f.reset(); btn.querySelector('span')!.textContent = 'Sent';
        status.textContent = 'Got it. I’ll come back to you within a few days.';
      } catch {
        btn.disabled = false; btn.querySelector('span')!.textContent = 'Send it into the world';
        status.textContent = 'That didn’t go through. Try again, or DM @ashah.world on Instagram.';
      }
    });
  }
</script>
<style>
  .c-wrap { position: relative; overflow: hidden; padding: 170px 0 110px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); position: relative; align-items: start; }
  h1 { font-size: clamp(56px, 8vw, 112px); margin-bottom: 24px; }
  .direct { margin-top: 44px; display: grid; gap: 16px; }
  .direct p { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; }
  .direct .label { width: 110px; }
  .else { display: flex; align-items: center; gap: 6px 18px; flex-wrap: wrap; }
  .direct a { border-bottom: 1px solid var(--line); }
  .direct a:hover { color: var(--peach); border-color: var(--peach); }
  .form-panel { padding: clamp(24px, 3vw, 40px); background: rgba(7, 11, 24, .6); border: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  form { display: grid; gap: 20px; }
  form .btn { justify-self: start; margin-top: 6px; }
  .note { margin: 0; }
  .embed :global(iframe) { width: 100%; min-height: 620px; border: 0; }
  .news { position: relative; padding-bottom: 120px; }
  .news .halo { filter: blur(90px); }
  .news-in { position: relative; max-width: 640px; padding-top: 80px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
