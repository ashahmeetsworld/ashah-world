---
// Orbit is off every touchpoint (Ashah, 6 Nov 2026; finished 14 Nov 2026).
// The page is kept as src/pages/_orbit.astro (the underscore stops Astro building it).
// Old links in sent emails and posts land here and go straight home.
import { u } from '../lib/url';
const home = u('/');
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0; url=${home}`} />
  <link rel="canonical" href={home} />
  <title>Ashah Meets World</title>
</head>
<body style="background:#070B18;color:#F6F1E7;font-family:sans-serif;">
  <p><a href={home} style="color:#7FD8F0;">Ashah Meets World</a></p>
  <script is:inline define:vars={{ home }}>location.replace(home);</script>
</body>
</html>
