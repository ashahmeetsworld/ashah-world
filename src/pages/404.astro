---
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Arrow from '../components/Arrow.astro';
import { u } from '../lib/url';
---
<Base title="Lost at sea">
  <section class="lost">
    <Sky variant="night" id="lost-sky" />
    <div class="wrap copy">
      <p class="eyebrow">404</p>
      <h1>Off the map.</h1>
      <p class="lede">This page drifted out past the reef. Follow the light back.</p>
      <a class="go glow" href={u('/')}>Back to the world <Arrow /></a>
    </div>
  </section>
</Base>
<style>
  .lost { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: hidden; }
  .copy { position: relative; }
  h1 { margin-bottom: 20px; }
  .lede { margin: 0 0 30px; }
</style>
