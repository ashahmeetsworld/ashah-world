---
import FirstLight from '../components/FirstLight.astro';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Waterline from '../components/Waterline.astro';
import MissionSky from '../components/MissionSky.astro';
import LuminaryLight from '../components/LuminaryLight.astro';
import DawnSky from '../components/DawnSky.astro';
import Door from '../components/Door.astro';
import about from '../data/about.json';
import site from '../data/site.json';
import { u } from '../lib/url';
---
<Base night title="About" description={about.lede}>
  <!-- ─── Hero ─── -->
  <section class="a-hero">
    <div class="halo" style="width:700px;height:460px;right:-180px;top:-80px;background:var(--violet);opacity:.55"></div>
    <div class="wrap a-grid">
      <div class="a-copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h1>{about.title}</h1>
        <p class="lede">{about.lede}</p>
        {about.intro?.map((t) => <p class="intro">{t}</p>)}
      </div>
      <figure class="a-art">
        {about.portrait ? (
          <img src={u(about.portrait)} alt="Ashah" />
        ) : (
          <Waterline />
        )}
        {about.portraitCaption && <figcaption>{about.portraitCaption}</figcaption>}
      </figure>
    </div>
  </section>

  <!-- ─── Mission ─── -->
  <section class="pad mission">
    <MissionSky />
    <div class="wrap rv">
      <p class="eyebrow">The mission</p>
      <blockquote>{about.mission}</blockquote>
    </div>
  </section>

  <!-- ─── Story ─── -->
  <section class="pad story">
    <DawnSky />
    <div class="wrap">
      <div class="head rv">
        <p class="eyebrow">{about.story.eyebrow ?? "My journey"}</p>
        <h2>{about.story.title}</h2>
      </div>
      <ol class="chapters">
        {about.story.chapters.map((c, i) => (
          <li class="rv" style={`--i:${i};--c:${['#7FD8F0', '#9C86FF', '#E04BAE', '#E08C7E', '#F2B48C'][i % 5]}`}>
            <span class="node" aria-hidden="true"></span>
            <p class="label"><span class="ch">{c.label}</span>{c.years && ` · ${c.years}`}</p>
            <h3>{c.title}</h3>
            <p class="txt">{c.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── Positioning ─── -->
  <section class="pad position">
    <LuminaryLight />
    <div class="wrap pos-grid">
      <div class="rv">
        <p class="eyebrow">{about.positioning.eyebrow ?? "The role I play"}</p>
        <h2>{about.positioning.title}</h2>
        {about.positioning.text.split(/\n\n+/).map((t) => <p class="body">{t}</p>)}
      </div>
      <dl class="rv points">
        {about.positioning.points.map((p) => (
          <div><dt class="label">{p.label}</dt><dd>{p.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── Close ─── -->
  <section class="pad close">
    <div class="wrap c-in">
      <div class="rv c-door"><Door /></div>
      <div class="rv c-copy">
        <h2>Step inside.</h2>
        <p class="lede">See what the world looks like in practice, or tell me about yours.</p>
        <div class="ctas">
          <a class="go glow" href={u('/work/')}>See the work <Arrow /></a>
          <a class="go" href={u('/contact/')}>Start a conversation <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
  <FirstLight />
</Base>
<style>
  .a-hero { position: relative; overflow: hidden; padding: 170px 0 clamp(60px, 8vw, 100px); }
  .a-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 90px); align-items: center; }
  .a-hero h1 { font-size: clamp(50px, 7vw, 100px); line-height: .98; margin-bottom: 26px; text-wrap: balance; }
  .a-copy .lede { margin-bottom: 22px; }
  .intro { color: var(--ink-2); font-size: 17.5px; max-width: 54ch; margin: 0 0 16px; }
  .a-art { margin: 0; border: 1px solid var(--line); box-shadow: 0 50px 140px -60px rgba(224, 75, 174, .45); }
  .a-art img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .a-art figcaption { font: italic 16px var(--serif); color: var(--ink-3); padding: 10px 14px; }

  .pos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .pos-grid h2 { margin-bottom: 22px; }
  .head { max-width: 720px; margin-bottom: clamp(44px, 6vw, 70px); }
  .head h2 { margin-bottom: 20px; }
  .chapters { list-style: none; padding: 0 0 0 34px; margin: 0; position: relative; display: grid; gap: clamp(40px, 5vw, 60px); max-width: 860px; }
  .story { padding-bottom: clamp(120px, 14vw, 200px); background:
    radial-gradient(38% 16% at 80% 12%, rgba(127, 216, 240, .06), transparent 70%),
    radial-gradient(42% 17% at 82% 31%, rgba(124, 92, 255, .08), transparent 70%),
    radial-gradient(44% 17% at 78% 50%, rgba(224, 75, 174, .075), transparent 70%),
    radial-gradient(48% 16% at 80% 64%, rgba(224, 140, 126, .09), transparent 70%),
    radial-gradient(50% 16% at 76% 80%, rgba(242, 180, 140, .1), transparent 72%),
    var(--midnight); }
  .chapters::before { content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(180deg, #7FD8F0, #9C86FF 30%, #E04BAE 55%, #E08C7E 78%, #F2B48C); opacity: .6; }
  .chapters li { position: relative; }
  .node { position: absolute; left: -34px; top: 4px; width: 13px; height: 13px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px color-mix(in srgb, var(--c) 18%, transparent), 0 0 20px var(--c); }
  .chapters .label { margin: 0 0 10px; }
  .ch { color: var(--c); }
  .chapters h3 { font-size: clamp(30px, 3.4vw, 42px); margin-bottom: 12px; }
  .txt { color: var(--ink-2); margin: 0; max-width: 62ch; }

  .points { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .points div { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .points dt { margin-bottom: 8px; color: var(--peach); }
  .points dd { margin: 0; font: italic 23px/1.35 var(--serif); }

  .mission { text-align: center; padding-bottom: clamp(130px, 14vw, 190px); }
  .mission .wrap { display: grid; justify-items: center; }
  .mission { background: radial-gradient(60% 70% at 50% 50%, rgba(58, 31, 102, .45), transparent 70%); }
  .echo { margin: 30px 0 0; font: 500 12px/1.8 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--peach); max-width: 60ch; }
  .mission blockquote { margin: 0; max-width: 24ch; font: italic 400 clamp(32px, 4.6vw, 60px)/1.15 var(--serif); text-wrap: balance; text-shadow: 0 0 60px rgba(127, 216, 240, .2); }

  .close { padding-top: clamp(40px, 5vw, 70px); isolation: isolate; }
  /* the light from the doorway spills into the room and up into the luminary blue above, no edges */
  .close::before { content: ''; position: absolute; z-index: -1; left: -10%; top: -45%; width: 85%; height: 160%; pointer-events: none;
    background:
      radial-gradient(closest-side at 50% 52%, rgba(90, 150, 220, .13), rgba(70, 110, 200, .07) 40%, transparent 100%),
      radial-gradient(closest-side at 38% 70%, rgba(138, 76, 142, .14), rgba(90, 52, 120, .06) 45%, transparent 100%),
      radial-gradient(closest-side at 62% 64%, rgba(224, 140, 126, .06), transparent 100%),
      radial-gradient(closest-side at 46% 30%, rgba(34, 54, 122, .12), rgba(34, 23, 90, .05) 55%, transparent 100%);
    animation: doorglow 7s ease-in-out infinite; }
  @keyframes doorglow { 0%, 100% { opacity: .85; } 50% { opacity: 1; } }
  .c-in { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(30px, 6vw, 90px); align-items: center; }
  .c-door { display: grid; justify-items: center; }
  .close h2 { font-size: clamp(54px, 8vw, 110px); margin-bottom: 16px; }
  .close .lede { margin: 0 0 30px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px 40px; }

  @media (max-width: 860px) {
    .a-grid, .pos-grid, .c-in { grid-template-columns: 1fr; }
    .c-door { max-width: 300px; margin: 0 auto; }
    .a-hero { padding-top: 130px; }
  }
</style>
