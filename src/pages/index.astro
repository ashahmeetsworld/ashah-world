---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Arrow from '../components/Arrow.astro';
import WorkCard from '../components/WorkCard.astro';
import SkillIcon from '../components/SkillIcon.astro';
import Lighthouse from '../components/Lighthouse.astro';
import Flame from '../components/Flame.astro';
import Prism from '../components/Prism.astro';
import Relay from '../components/Relay.astro';
import HeroScene from '../components/HeroScene.astro';
import MissionSky from '../components/MissionSky.astro';
import DawnScene from '../components/DawnScene.astro';
import Signup from '../components/Signup.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import NightPass from '../components/NightPass.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import { u, skillColour } from '../lib/url';
import { LIVE_FROM_INSTAGRAM } from '../lib/live';

const work = (await getCollection('work', (e) => !e.data.draft && e.data.featured)).sort((a, b) => a.data.order - b.data.order);
// The offer, thesis and opportunity sections are archived while the offer is validated (15 Oct 2026).
// Set SHOW_OFFER to true (and the offer file's draft to false) to bring them back.
const SHOW_OFFER = false;
// Prism visual beside "Four lights, one beam" (src/components/Prism.astro). Off for now; set true to try it again.
const SHOW_PRISM = false;
// Prism relay between the skill cards and the work (src/components/Relay.astro). Off; set true to try it again.
const SHOW_RELAY = false;
// The elevated hero (HeroScene.astro, 18 Oct 2026). Set false to go back to the original night sky.
const ELEVATED_HERO = true;
const ubiquity = SHOW_OFFER ? await getEntry('offers', 'ubiquity') : undefined;
const ig = site.socials.find((s) => s.label === 'Instagram')?.url;

const skills = [
  { name: 'Creative Direction', key: '--cd', metaphor: 'The North Star', role: 'sets the vision', text: 'Taste, worldbuilding and story decide what the world is, so every shoot, post and campaign is steered by the same light.' },
  { name: 'Ecosystem Design', key: '--eco', metaphor: 'The living reef', role: 'makes it cohesive', text: 'Systems, templates and funnels that keep every touchpoint (feed, site, packaging, DMs, drops) unmistakably the same world.' },
  { name: 'Cultural Leadership', key: '--cul', metaphor: 'Fireflies in sync', role: 'opens the rooms', text: 'The relationships, rooms and trust that bring artists, brands and community into the same rhythm.' },
  { name: 'Campaign Marketing', key: '--cam', metaphor: 'The meteor shower', role: 'makes it impossible to miss', text: 'Ubiquity and spectacle that turn a world into a moment, and a moment into attention, desire and sales.' },
];
---
<Base>
  <NightPass />

  <!-- ─── Hero: city lights on water ─── -->
  <section class="hero">
    {ELEVATED_HERO ? <HeroScene /> : <Sky variant="night" id="hero-sky" />}
    <div class="hero-fade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">{site.tagline}</p>
      <h1>Ashah<br /><span class="indent">Meets World</span></h1>
      <p class="lede">{site.intro}</p>
      <div class="ctas">
        <a class="go glow" href={u('/work/')}>See the work <Arrow /></a>
        <a class="go aurora-line" href={u('/contact/')}><span class="t">Work with me</span> <Arrow /></a>
      </div>
    </div>
    <p class="scroll label">Scroll · step inside</p>
  </section>

  <!-- ─── Hello: who's behind the world ─── -->
  <section class="pad thesis hello">
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap grid-2">
      <div class="rv">
        <p class="eyebrow">Hello</p>
        <h2>I'm Ashah.</h2>
        <p class="body">{about.intro[0]}</p>
        <a class="go" href={u('/about/')}>More about me <Arrow /></a>
      </div>
      <div class="rv mission-mini">
        <MissionSky />
        <blockquote class="quote">
          <p>{about.mission.replace(/^My mission is to /, '').replace(/^./, (c) => c.toUpperCase())}</p>
          <footer class="label">The mission</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ─── Thesis (archived) ─── -->
  {SHOW_OFFER && <section class="pad thesis">
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap grid-2">
      <div class="rv">
        <p class="eyebrow">The thesis</p>
        <h2>Windows<br />and doors.</h2>
        <p class="body">Most brands are windows: beautiful, lit, looked at. The ones that last are doors. You walk through, and you never quite leave.</p>
      </div>
      <blockquote class="rv quote">
        <p>“The brands that last aren’t seen; they’re entered, and a brand becomes a culture when people can live inside it. I build those worlds: immersive, cohesive, and unforgettable.”</p>
        <footer class="label">Craft builds the window. I build the door, and the world behind it.</footer>
      </blockquote>
    </div>
  </section>}

  <!-- ─── The gap (archived) ─── -->
  {SHOW_OFFER && <section class="pad gap">
    <div class="wrap grid-2 flip">
      <div class="rv art"><Lighthouse /></div>
      <div class="rv">
        <p class="eyebrow">The opportunity</p>
        <h2>Lantern to lighthouse.</h2>
        <p class="body">A lantern is beautiful up close. A lighthouse is seen from miles away. Same flame, different structure around it. Melbourne’s best independent labels already have the flame: craft, vision, community. What’s missing is the structure that throws it further: strategy and spectacle.</p>
        <ul class="beams">
          <li><span>Capture</span> attention</li>
          <li><span>Create</span> desire</li>
          <li><span>Inspire</span> action</li>
        </ul>
      </div>
    </div>
  </section>}

  <!-- ─── Four lights, one beam ─── -->
  <section class={`pad skills${SHOW_RELAY ? ' relay-on' : ''}`}>
    <div class="wrap">
      <div class="skills-top">
      <div class="head rv">
        <p class="eyebrow">The skill stack</p>
        <h2>Four lights, one beam.</h2>
        <p class="body">Shine four coloured lights through a prism the right way and they don’t turn to mud. They become one brilliant beam: a world people can step into.</p>
      </div>
      {SHOW_PRISM && <div class="prism-wrap rv"><Prism /></div>}
      </div>
      <div class="cards swipe" id="skill-row" aria-label="The four skills">
        {skills.map((s, i) => (
          <article class="card rv" style={`--a:var(${s.key});transition-delay:${i * 90}ms`}>
            <div class="icon"><SkillIcon skill={s.name} /></div>
            <p class="label"><i></i>{s.role}</p>
            <h3>{s.name}</h3>
            <p class="metaphor">{s.metaphor}</p>
            <p class="txt">{s.text}</p>
          </article>
        ))}
      </div>
      <div class="dots" data-for="skill-row" aria-hidden="true"></div>
    {SHOW_RELAY && <Relay />}
    </div>
  </section>

  <!-- ─── Selected work ─── -->
  <section class="pad work" id="work">
    <div class="wrap">
      <div class="row-head rv">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Proof of work.</h2>
        </div>
        <a class="go" href={u('/work/')}>All work <Arrow /></a>
      </div>
      <div class={`work-grid${work.length >= 3 ? ' lead' : ' even'}`}>
        {work.slice(0, 3).map((w, i) => (
          <div class={`rv w${i}`}><WorkCard entry={w} /></div>
        ))}
      </div>
      {/* Phones: the work as a feed, scroll down through the projects and swipe sideways through each one's images */}
      <div class="work-feed">
        {work.map((w) => {
          const imgs = [w.data.cover, ...w.data.gallery.map((g) => g.image)].filter((v, i, a) => a.indexOf(v) === i).slice(0, 7);
          const ratio = w.data.coverRatio === 'portrait' ? '4 / 5' : '16 / 10';
          const live = LIVE_FROM_INSTAGRAM.includes(w.id);
          return (
            <article class="post" style={`--accent:${skillColour[w.data.skill]}`}>
              <a class="post-head" href={u(`/work/${w.id}/`)}><i aria-hidden="true"></i><span class="serif">{w.data.title}</span><span class="label">{w.data.skill}</span></a>
              <div class="car" style={`--ratio:${ratio}`} data-live={live ? 'latest' : undefined} data-feed={live ? site.instagramFeedUrl : undefined}>
                <div class="car-track">
                  {imgs.map((src, i) => <div class="car-slide"><img src={u(src)} alt={i === 0 ? w.data.title : ''} loading={i === 0 ? undefined : 'lazy'} decoding="async" /></div>)}
                </div>
                <div class="car-dots" aria-hidden="true"></div>
              </div>
              <p class="post-cap">{w.data.summary}</p>
              <a class="go" href={u(`/work/${w.id}/`)}>See the project <Arrow /></a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ─── Offer stack ─── -->
  {ubiquity && (
    <section class="pad offer">
      <div class="halo" style="width:640px;height:420px;right:-120px;top:20%;background:#8A2B3B"></div>
      <div class="wrap">
        <div class="row-head rv">
          <div>
            <p class="eyebrow">Ubiquity · the offer</p>
            <h2>Spark to wildfire.</h2>
            <p class="body">A fire isn’t lit with a log. Sparks catch kindling, kindling becomes flame, flame becomes a bonfire, and the right one becomes a hearth that burns all season.</p>
          </div>
        </div>
        <ol class="stack">
          {ubiquity.data.tiers.map((t, i) => (
            <li class={`rv ${t.highlight ? 'hl' : ''}`} style={`transition-delay:${i * 90}ms`}>
              <Flame level={[0, 2, 3, 1][i] ?? 1} />
              <p class="label">{t.stage}</p>
              <h3>{t.name}</h3>
              <p class="price">{t.price}</p>
              <p class="txt">{t.text}</p>
            </li>
          ))}
        </ol>
        <div class="rv center"><a class="go glow" href={u('/ubiquity/')}>How Ubiquity works <Arrow /></a></div>
      </div>
    </section>
  )}

  <!-- ─── From the feed (live Instagram) ─── -->
  <section class="pad notes" id="feed">
    <div class="wrap row-head rv">
      <div>
        <p class="eyebrow">From the feed</p>
        <h2>Fresh from the world.</h2>
        <p class="body">What I'm making, noticing and building right now, straight from Instagram.</p>
      </div>
      {ig && <a class="go" href={ig} rel="noopener">Follow on Instagram <Arrow /></a>}
    </div>
    <InstagramFeed />
  </section>

  <!-- ─── First light: the sunset, then the newsletter ─── -->
  <section class="finale">
    <div class="scene"><DawnScene /></div>
    <div class="wrap" id="letters"><div class="rv panel"><Signup /></div></div>
  </section>
</Base>

<script>
  import { wireAll } from '../lib/carousel';
  import { loadFeed, carousels, slidesOf } from '../lib/feed';
  // Phone swipe row for the skill cards: dots underneath show where you are; tap one to jump.
  // They only show when the row actually scrolls sideways (phones), so desktop is unchanged.
  document.querySelectorAll<HTMLElement>('.dots[data-for]').forEach((dots) => {
    const row = document.getElementById(dots.dataset.for!);
    if (!row) return;
    const kids = Array.from(row.children) as HTMLElement[];
    dots.innerHTML = kids.map((_, i) => `<button type="button" tabindex="-1" aria-label="Show card ${i + 1}"><i></i></button>`).join('');
    const pad = () => parseFloat(getComputedStyle(row).scrollPaddingLeft) || 0;
    dots.querySelectorAll('button').forEach((b, i) => b.addEventListener('click', () =>
      row.scrollTo({ left: row.scrollLeft + kids[i].getBoundingClientRect().left - row.getBoundingClientRect().left - pad(), behavior: 'smooth' })));
    const update = () => {
      dots.hidden = row.scrollWidth <= row.clientWidth + 4;
      const edge = row.getBoundingClientRect().left + pad();
      let active = 0, best = Infinity;
      kids.forEach((k, i) => { const d = Math.abs(k.getBoundingClientRect().left - edge); if (d < best) { best = d; active = i; } });
      if (row.scrollLeft >= row.scrollWidth - row.clientWidth - 4) active = kids.length - 1;
      dots.querySelectorAll('button').forEach((b, i) => b.classList.toggle('on', i === active));
    };
    row.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  });

  // Field Notes in the phone work feed: swap in the latest carousel from Instagram, so it's always the real, final post.
  document.querySelectorAll<HTMLElement>('.car[data-live][data-feed]').forEach(async (car) => {
    try {
      const latest = carousels(await loadFeed(car.dataset.feed!))[0];
      const imgs = latest ? slidesOf(latest).slice(0, 10) : [];
      const track = car.querySelector('.car-track');
      if (!imgs.length || !track) return;
      track.innerHTML = imgs.map((src, i) => `<div class="car-slide"><img src="${src}" alt="${i === 0 ? 'Field Notes, latest post' : ''}" loading="lazy" decoding="async" /></div>`).join('');
      car.style.setProperty('--ratio', '4 / 5');
      delete car.dataset.wired;
      wireAll(car.parentElement!);
    } catch { /* keep the images that shipped with the page */ }
  });
  wireAll();
</script>

<style>
  /* hero */
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  /* the hero melts into the sky behind the page: no solid band, so no hard line where it ends */
  .hero :global(.hs) { -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%); mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%); }
  .hero-fade { display: none; }
  .hero-copy { position: relative; z-index: 2; padding-bottom: clamp(96px, 16vh, 170px); }
  .hero-fade, .hero .scroll { z-index: 1; }
  .hero h1 { text-shadow: 0 0 60px rgba(127, 216, 240, .18); }
  .indent { padding-left: .55em; }
  .hero .lede { margin: 28px 0 34px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px 40px; }
  /* Work with me: same link, but its line of light is the Ubiquity aurora */
  .go.aurora-line { border-bottom: 0; position: relative; }
  .go.aurora-line::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1.5px; background: linear-gradient(90deg, #7FD8F0, #8FB4F6 30%, #A996FF 55%, #7FD8F0 80%, #A9EAF7); background-size: 250% 100%; box-shadow: 0 0 10px rgba(127, 216, 240, .45); animation: au-line 8s ease-in-out infinite alternate; transition: box-shadow .4s, height .4s; }
  .go.aurora-line:hover { color: #A9EAF7; }
  .go.aurora-line:hover .t { background: linear-gradient(90deg, #7FD8F0, #A996FF 55%, #A9EAF7); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: au-line 4s ease-in-out infinite alternate; }
  .go.aurora-line:hover::after { height: 2px; box-shadow: 0 0 18px rgba(127, 216, 240, .7), 0 0 34px rgba(156, 134, 255, .4); }
  @keyframes au-line { to { background-position: 100% 0; } }
  .scroll { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); margin: 0; animation: bob 3s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translate(-50%, 6px); opacity: .6; } }

  .grid-2 { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 7vw, 110px); align-items: center; position: relative; }
  .grid-2 h2 { margin-bottom: 26px; }
  .hello .body { margin-bottom: 30px; }
  /* the About page's mission, quieter: twinkling stars and slow ripples, faded at the edges so it melts into the page */
  .mission-mini { position: relative; isolation: isolate; padding-block: clamp(40px, 5vw, 70px);
    background: radial-gradient(60% 65% at 45% 50%, rgba(58, 31, 102, .34), transparent 72%); }
  .mission-mini :global(.ms) { z-index: -1; opacity: .75; left: -14%; width: 128%; -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 100%); mask-image: radial-gradient(closest-side, #000 62%, transparent 100%); }
  .skills, .notes, .offer { overflow: hidden; }
  /* soft, layered night light behind Windows and doors: no single colour, no edges */
  .thesis .ambient { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(closest-side at 18% 46%, rgba(22, 54, 122, .42), rgba(22, 54, 122, .18) 45%, transparent 100%),
      radial-gradient(closest-side at 30% 70%, rgba(58, 31, 102, .38), rgba(58, 31, 102, .12) 50%, transparent 100%),
      radial-gradient(closest-side at 10% 28%, rgba(127, 216, 240, .1), transparent 100%),
      radial-gradient(closest-side at 42% 52%, rgba(138, 76, 142, .12), transparent 100%),
      radial-gradient(closest-side at 78% 40%, rgba(34, 23, 90, .22), transparent 100%);
    background-size: 70% 110%, 60% 90%, 40% 60%, 55% 80%, 60% 90%;
    background-position: 0% 50%, 10% 90%, 0% 10%, 30% 50%, 100% 40%;
    background-repeat: no-repeat;
    filter: blur(20px); animation: amb 14s ease-in-out infinite alternate; }
  @keyframes amb { to { opacity: .8; transform: translate3d(2%, -1%, 0) scale(1.03); } }
  .quote { margin: 0; padding-left: clamp(20px, 3vw, 40px); border-left: 1px solid var(--peach); }
  .quote p { font: italic 400 clamp(26px, 3vw, 40px)/1.28 var(--serif); margin: 0 0 26px; }
  .quote footer { color: var(--peach); line-height: 1.7; }

  .gap { background: linear-gradient(180deg, var(--midnight), #120C33 50%, var(--midnight)); }
  .flip .art { order: 0; }
  .art { box-shadow: 0 40px 120px -50px rgba(242, 180, 140, .35); }
  .beams { list-style: none; padding: 0; margin: 34px 0 0; display: grid; gap: 4px; }
  .beams li { font: italic 400 clamp(24px, 2.4vw, 30px)/1.35 var(--serif); color: var(--ink-2); display: flex; gap: .4em; align-items: baseline; }
  .beams li::before { content: ''; width: 46px; height: 1px; background: linear-gradient(90deg, var(--peach), transparent); align-self: center; margin-right: 10px; }
  .beams span { color: var(--peach); }

  .head { max-width: 700px; margin-bottom: clamp(48px, 6vw, 80px); }
  .head h2 { margin-bottom: 22px; }
  .skills-top { display: grid; grid-template-columns: minmax(0, 700px) minmax(0, 1fr); gap: clamp(30px, 4vw, 60px); align-items: center; margin-bottom: clamp(48px, 6vw, 80px); }
  .skills-top .head { margin-bottom: 0; }
  .prism-wrap { justify-self: end; width: 100%; }
  @media (max-width: 860px) { .skills-top { grid-template-columns: 1fr; } .prism-wrap { justify-self: start; max-width: 300px; } }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  @media (min-width: 861px) { .skills.relay-on { padding-bottom: 0; } .relay-on + .work { padding-top: clamp(18px, 2.4vw, 34px); } }
  .card { position: relative; padding: 30px 26px 32px; background: linear-gradient(180deg, rgba(22, 30, 70, .5), rgba(7, 11, 24, .2)); border: 1px solid var(--line); overflow: hidden; }
  .card::before { content: ''; position: absolute; inset: -40% -40% auto auto; width: 260px; height: 260px; border-radius: 50%; background: var(--a); filter: blur(70px); opacity: .22; transition: opacity .6s; }
  .card:hover::before { opacity: .42; }
  .card .icon { width: 84px; height: 84px; margin-bottom: 26px; position: relative; }
  .card .label { display: flex; gap: 10px; align-items: center; margin: 0 0 14px; }
  .card .label i { width: 7px; height: 7px; border-radius: 50%; background: var(--a); box-shadow: 0 0 12px var(--a); }
  .card h3 { font-size: 30px; margin-bottom: 4px; }
  .metaphor { font: italic 19px/1.3 var(--serif); color: var(--a); margin: 0 0 16px; filter: brightness(1.35); }
  .txt { color: var(--ink-2); font-size: 15px; margin: 0; }

  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 30px; flex-wrap: wrap; margin-bottom: clamp(44px, 5vw, 72px); }
  .row-head h2 { margin-bottom: 18px; }
  .row-head .body { margin: 0; }
  .work-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(36px, 5vw, 64px) clamp(24px, 4vw, 56px); }
  .work-grid.even { grid-template-columns: 1fr 1fr; }
  .work-grid.lead .w0 { grid-row: span 2; }
  .work-grid.lead .w0 :global(.frame) { aspect-ratio: 4 / 5; }

  .offer { background: linear-gradient(180deg, var(--midnight), #1C0D1E 55%, var(--midnight)); }
  .stack { list-style: none; padding: 0; margin: 0 0 56px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .stack li { padding: 34px 26px 30px; border-right: 1px solid var(--line); position: relative; }
  .stack li:last-child { border-right: 0; }
  .stack li.hl { background: radial-gradient(120% 70% at 50% 0%, rgba(242, 180, 140, .12), transparent 70%); }
  .stack .label { margin: 18px 0 8px; color: var(--rose); }
  .stack h3 { font-size: 32px; }
  .price { font: 500 13px/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--peach); margin: 12px 0 16px; }
  .center { text-align: center; }

  .notes :global(.strip) { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(220px, 24vw, 300px); gap: 16px; overflow-x: auto; padding: 0 var(--gutter) 20px; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: thin; scrollbar-color: var(--violet) transparent; }
  @media (min-width: 1280px) { .notes :global(.strip) { padding-left: calc((100vw - var(--max)) / 2); scroll-padding-inline: calc((100vw - var(--max)) / 2); } }
  .notes :global(.note-card) { scroll-snap-align: start; position: relative; display: block; border: 1px solid var(--line); overflow: hidden; }
  .notes :global(.note-card img) { aspect-ratio: 4 / 5; width: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .notes :global(.note-card:hover img) { transform: scale(1.04); }
  .notes :global(.cap) { display: flex; gap: 10px; align-items: baseline; padding: 14px 4px 0; font: italic 19px/1.2 var(--serif); color: var(--ink-2); }
  .notes :global(.cap b) { font: 500 11px var(--sans); letter-spacing: .2em; color: var(--peach); }


  .finale { position: relative; overflow: hidden; padding-top: 0; padding-bottom: 90px; }
  /* the footer sits in the first light too, on this page only */
  :global(body:has(.np) footer) { background: linear-gradient(180deg, transparent, rgba(7, 11, 24, .55)); }
  .finale-copy { position: relative; text-align: center; display: grid; justify-items: center; z-index: 1; }
  .finale-copy .ctas { justify-content: center; }
  .scene { position: relative; aspect-ratio: 16 / 6; min-height: 300px; max-height: 480px; width: 100%; margin-top: 0; }
  /* the night passes: the dawn scene melts into the warmed sky above it instead of a midnight band */
  .scene { -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 24%, #000 78%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0%, #000 24%, #000 78%, transparent 100%); }
  .finale .panel { position: relative; max-width: 640px; margin: -120px auto 0; z-index: 1; }
  .big { font-size: clamp(60px, 10vw, 140px); line-height: .95; margin-bottom: 22px; text-shadow: 0 0 50px rgba(242, 180, 140, .25); }
  .finale .lede { color: var(--ink); margin: 0 0 30px; max-width: 30ch; }
  .panel { padding: 34px; background: rgba(7, 11, 24, .62); border: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

  @media (max-width: 980px) {
