---
// New home page (17 Nov 2026): one long page, no nav. Door > free tools > Instagram feed > The work > the Session (lighthouse).
// Built as a standalone page from src/home/home.html; assets live in public/home/.
// The old home is kept as src/pages/_home-v1.astro (the underscore stops Astro building it).
// To restore it: delete this file and rename _home-v1.astro back to index.astro.
// "The work." (20 Nov 2026): built from the work collection by src/lib/workfeature.ts and dropped in just before the Session.
import { getCollection } from 'astro:content';
import html from '../home/home.html?raw';
import siteData from '../data/site.json';
import { workFeature } from '../lib/workfeature';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : '';
const work = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const SESSION = '<section class="scn t1" id="session">';
const out = html.replace(/^<!doctype html>/i, '')
  .replace(SESSION, workFeature(work, base, siteData.instagramFeedUrl || '') + SESSION)
  .replaceAll('__BASE__', base).replaceAll('__SITE__', site);
---
<Fragment set:html={out} />
