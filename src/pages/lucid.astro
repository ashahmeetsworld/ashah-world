---
// Lucid: the creative sanctuary (Ashah's personal workstation product). Coming soon.
// Doors open Mon 4 January 2027; teasers from about 21 December 2026, handing over from Orbit.
// Look: opal (pearl, lilac, aqua, blush) in a dream where the rules bend. Never aurora (Orbit) or ember.
// Linked from the footer only, not the header. Lucid is NOT part of Orbit.
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import LucidSignup from '../components/LucidSignup.astro';

const VERSION = '0.3';
const glimpses = [
  { f: 'door-drift', t: 'Doors rise from still water' },
  { f: 'door-climb', t: 'A stair of light' },
  { f: 'door-glow', t: 'The one that’s yours' },
];
const OPEN = '2027-01-04T00:00:00+11:00'; // Melbourne, daylight time
const crafts = ['videographer', 'designer', 'game dev', 'music producer', 'photographer', 'writer', 'illustrator', 'fashion designer', '3D artist', 'animator', 'architect', 'DJ', 'tattoo artist', 'podcaster', 'painter', 'choreographer'];
const phases = [
  { n: 'Dream', t: 'Dream it up. Let ideas wander.' },
  { n: 'Conjure', t: 'Bring it to life.' },
  { n: 'Unfold', t: 'Break it down, piece by piece.' },
  { n: 'Awaken', t: 'Bring it home. It’s real now.' },
];
// Each workstation = a room's own steps, run as lanes down a project's desk; the four phases run across.
// c = which phase the sample card sits in (0 Dream .. 3 Awaken).
const stations = [
  { id: 'content', n: 'Content', line: 'One worksheet becomes a month of pieces.', steps: [
    { n: 'Worksheet', c: 3, t: 'This month’s riffs' },
    { n: 'Macro', c: 2, t: 'The long video' },
    { n: 'Micro', c: 1, t: 'Twelve posts cut down' },
    { n: 'Approved', c: 0, t: 'Monday’s drop' },
  ] },
  { id: 'music', n: 'Music', line: 'A song, built in three layers.', steps: [
    { n: 'Beat', c: 3, t: 'Drums bounced' },
    { n: 'Lyrics', c: 2, t: 'Second verse' },
    { n: 'Vocals', c: 1, t: 'Rough take' },
  ] },
  { id: 'fashion', n: 'Fashion', line: 'From a feeling to a garment someone can make.', steps: [
    { n: 'References', c: 3, t: 'Board locked' },
    { n: 'Vision', c: 2, t: 'Collection story' },
    { n: 'Artboard', c: 1, t: 'Flats for six pieces' },
    { n: 'Tech pack', c: 0, t: 'Fabric notes' },
  ] },
  { id: 'yours', n: 'Your craft', line: 'Tell Lucid how you work. It draws your steps.', steps: [
    { n: 'Your step', c: -1, t: '' },
    { n: 'Your step', c: -1, t: '' },
    { n: 'Your step', c: -1, t: '' },
  ] },
];
---
<Base title="Lucid" description="A creative sanctuary for every medium you make in. A dream you get to steer. Doors open 4 January 2027." bodyClass="lucid">

  <!-- Hero: the moment you realise it's a dream -->
  <section class="l-hero">
    <svg class="scene" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="lsky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#070B18"/><stop offset=".55" stop-color="#16184A"/><stop offset="1" stop-color="#2A1B5E"/></linearGradient>
        <radialGradient id="lglow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#F4EEFF" stop-opacity=".42"/><stop offset=".35" stop-color="#C9BCFF" stop-opacity=".18"/><stop offset=".65" stop-color="#7FD8F0" stop-opacity=".06"/><stop offset="1" stop-color="#7FD8F0" stop-opacity="0"/></radialGradient>
        <linearGradient id="lopal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFF6EC"/><stop offset=".35" stop-color="#E9D8FF"/><stop offset=".65" stop-color="#BFEFF7"/><stop offset="1" stop-color="#F2C6E0"/></linearGradient>
        <linearGradient id="lwater" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14123E"/><stop offset="1" stop-color="#070B18"/></linearGradient>
      </defs>
      <rect width="1920" height="1080" fill="url(#lsky)"/>
      <g transform="translate(0 80)">
      <g class="stars" fill="#F6F1E7"><circle cx="160" cy="110" r="1.4"/><circle cx="520" cy="60" r="1.2"/><circle cx="820" cy="180" r="1"/><circle cx="1780" cy="90" r="1.5"/><circle cx="1640" cy="560" r="1"/><circle cx="360" cy="380" r="1"/><circle cx="1180" cy="40" r="1.2"/><circle cx="1010" cy="300" r=".9"/><circle cx="1880" cy="420" r="1.1"/></g>
      <circle class="breathe" cx="1360" cy="340" r="520" fill="url(#lglow)"/>
      <g fill="url(#lopal)">
        <path class="d d1" d="M1150 360 L1150 260 A30 30 0 0 1 1210 260 L1210 360 Z" transform="rotate(-6 1180 300)"/>
        <path class="d d2" d="M1362 300 L1362 170 A38 38 0 0 1 1438 170 L1438 300 Z" transform="rotate(4 1400 220)"/>
        <path class="d d3" d="M1596 388 L1596 306 A24 24 0 0 1 1644 306 L1644 388 Z" opacity=".8" transform="rotate(-3 1620 340)"/>
        <path class="d d4" d="M984 490 L984 440 A16 16 0 0 1 1016 440 L1016 490 Z" opacity=".55" transform="rotate(8 1000 460)"/>
        <path class="d d5" d="M1748 224 L1748 186 A12 12 0 0 1 1772 186 L1772 224 Z" opacity=".45" transform="rotate(-10 1760 200)"/>
        <path class="d d6" d="M1508 548 L1508 506 A12 12 0 0 1 1532 506 L1532 548 Z" opacity=".4" transform="rotate(5 1520 520)"/>
      </g>
      <g fill="#C9BCFF" class="stair">
        <rect x="760" y="828" width="70" height="8" rx="3" opacity=".5"/><rect x="850" y="770" width="70" height="8" rx="3" opacity=".56"/><rect x="940" y="712" width="70" height="8" rx="3" opacity=".62"/><rect x="1030" y="654" width="70" height="8" rx="3" opacity=".68"/><rect x="1120" y="596" width="70" height="8" rx="3" opacity=".74"/><rect x="1210" y="538" width="70" height="8" rx="3" opacity=".8"/><rect x="1300" y="480" width="70" height="8" rx="3" opacity=".86"/><rect x="1370" y="422" width="60" height="8" rx="3" opacity=".9"/>
      </g>
      <g fill="#05070F"><circle cx="1060" cy="618" r="8"/><path d="M1051 628 h18 l3 26 h-6 l-1 -2 l2 20 h-4 l-3 -16 l-3 16 h-4 l1 -20 l-1 2 h-6 z"/></g>
      <path d="M0 860 L1920 860 L1920 1080 L0 1080 Z" fill="url(#lwater)"/>
      <g fill="url(#lopal)" class="shimmer"><rect x="1300" y="880" width="140" height="3"/><rect x="1330" y="900" width="90" height="3"/><rect x="1280" y="926" width="170" height="2"/><rect x="1350" y="954" width="60" height="2"/><rect x="1150" y="890" width="60" height="2"/></g>
      </g>
    </svg>
    <div class="fade"></div>
    <div class="wrap l-copy">
      <p class="tag"><span class="soon">Coming soon</span><span>Lucid v{VERSION}</span></p>
      <h1 class="opal">Lucid</h1>
      <p class="line">A dream you get to steer.</p>
      <p class="lede">A creative sanctuary for every medium you make in.</p>
      <div class="count" data-open={OPEN}>
        <p class="when">Doors open <strong>4 January 2027</strong></p>
        <p class="days" aria-live="polite"><span class="n">&nbsp;</span> <span class="unit">nights to go</span></p>
        <a class="save-cta" href="#list">Save me a door</a>
      </div>
    </div>
  </section>

  <!-- Glimpses: little loops seen through door frames (from the launch reels) -->
  <section class="l-glimpse" aria-label="Glimpses of Lucid">
    <div class="wrap">
      <div class="gl-row">
        {glimpses.map((g, i) => (
          <figure class="gl" style={`--i:${i}`}>
            <div class="gl-door">
              <video src={u(`/lucid/${g.f}.mp4`)} poster={u(`/lucid/${g.f}.jpg`)} muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video>
            </div>
            <figcaption>{g.t}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Rooms: any craft -->
  <section class="l-rooms">
    <div class="halo h1"></div>
    <div class="wrap">
      <p class="eyebrow">Your rooms</p>
      <h2>Five rooms. Any craft you can name.</h2>
      <p class="sub">Nothing is preset. A short chat with Lucid learns how you work in each craft and what you really need, then builds that room around you.</p>
      <div class="doors">
        <div class="door content"><span class="lab">Optional</span><span class="nm">Content</span><span class="ln">Pairs with your Content Producer in Orbit.</span></div>
        {[1, 2, 3, 4, 5].map((i) => (
          <div class="door open-slot" style={`--i:${i}`}><span class="lab">Room {i}</span><span class="nm">Any craft</span><span class="ln">You name it.</span><span class="veil" aria-hidden="true">Soon</span></div>
        ))}
      </div>
      <p class="crafts">{crafts.join(' · ')} · or whatever you are.</p>
    </div>
  </section>

  <!-- Four phases -->
  <section class="l-phases">
    <div class="wrap">
      <p class="eyebrow">How a dream becomes real</p>
      <h2>Every dream moves in four phases.</h2>
      <p class="sub">Structure to lean on, with room to wander back and forth. Each room keeps its own steps inside them.</p>
      <ol class="steps">
        {phases.map((p, i) => (
          <li style={`--i:${i}`}><svg viewBox="0 0 60 90" aria-hidden="true"><path d="M6 88 L6 30 A24 24 0 0 1 54 30 L54 88 Z" fill="url(#lopal2)" style={`opacity:${0.4 + i * 0.2}`}/></svg><span class="nm">{p.n}</span><span class="ln">{p.t}</span></li>
        ))}
      </ol>
      <svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs><linearGradient id="lopal2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFF6EC"/><stop offset=".35" stop-color="#E9D8FF"/><stop offset=".65" stop-color="#BFEFF7"/><stop offset="1" stop-color="#F2C6E0"/></linearGradient></defs></svg>
    </div>
  </section>

  <!-- Workstations: inside the four phases, each room's own steps run down as lanes (the project desk) -->
  <section class="l-stations">
    <div class="halo h2"></div>
    <div class="wrap">
      <p class="eyebrow">Inside the four phases</p>
      <h2>Every room has its own flow.</h2>
      <p class="sub">The four phases run across. Your craft’s own steps run down. Every project gets a desk like this.</p>
      <div class="st-tabs" role="tablist" aria-label="Workstations">
        {stations.map((w, i) => (
          <button type="button" role="tab" class="st-tab" aria-selected={i === 0 ? 'true' : 'false'} data-st={w.id}>{w.n}</button>
        ))}
      </div>
      <div class="st-stage">
        {stations.map((w, i) => (
          <div class={`st-panel${i === 0 ? ' on' : ''}${w.id === 'yours' ? ' yours' : ''}`} data-st={w.id} role="tabpanel" aria-hidden={i === 0 ? 'false' : 'true'}>
            <p class="st-line">{w.line}</p>
            <div class="desk" role="table" aria-label={`${w.n} desk`}>
              <div class="dk-row dk-head" role="row">
                <span class="dk-lane" role="columnheader"></span>
                {phases.map((ph) => <span class="dk-ph" role="columnheader">{ph.n}</span>)}
              </div>
              {w.steps.map((st, j) => (
                <div class="dk-row" role="row" style={`--j:${j}`}>
                  <span class="dk-lane" role="rowheader"><span class="arch" aria-hidden="true"></span>{st.n}</span>
                  {phases.map((_, k) => (
                    <span class="dk-cell" role="cell">{st.c === k && <span class="dk-card">{st.t}</span>}</span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Steer: half describing, half shaping -->
  <section class="l-steer">
    <div class="wrap split">
      <div>
        <p class="eyebrow">How you steer</p>
        <h2>Half describing. Half shaping.</h2>
        <p class="sub">Say what you see, then move it with your hands. Back and forth until it feels right.</p>
      </div>
      <svg class="half" viewBox="0 0 420 580" aria-hidden="true">
        <path d="M10 570 L10 210 A200 200 0 0 1 210 10 L210 570 Z" fill="none" stroke="#BFEFF7" stroke-width="2" stroke-dasharray="8 10" opacity=".7"/>
        <path d="M210 570 L210 10 A200 200 0 0 1 410 210 L410 570 Z" fill="url(#lopal2)"/>
        <g fill="#BFEFF7" opacity=".55"><rect x="40" y="250" width="140" height="5" rx="2"/><rect x="40" y="290" width="110" height="5" rx="2"/><rect x="40" y="330" width="80" height="5" rx="2"/><rect x="40" y="370" width="140" height="5" rx="2"/><rect x="40" y="410" width="110" height="5" rx="2"/></g>
      </svg>
    </div>
  </section>

  <!-- Pairing: Orbit and Lucid -->
  <section class="l-pair">
    <div class="wrap">
      <h2><span class="aur">Orbit</span> runs the business.<br/><span class="opal">Lucid</span> is where you make.</h2>
      <p class="sub">Same sky, its own room. Two separate doors into one world.</p>
      <a class="go" href={u('/orbit/')}>While you wait, meet Orbit <svg viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor"/></svg></a>
    </div>
  </section>

  <!-- Close -->
  <section class="l-close">
    <div class="glow"></div>
    <div class="wrap">
      <svg class="ajar" viewBox="0 0 160 260" aria-hidden="true"><path d="M10 255 L10 80 A70 70 0 0 1 150 80 L150 255 Z" fill="url(#lopal2)" opacity=".9"/><path d="M10 255 L10 80 A70 70 0 0 1 80 10 L80 255 Z" fill="#0B1230" opacity=".55"/></svg>
      <p class="eyebrow">Lucid v{VERSION} · coming soon</p>
      <h2>The doors open on 4 January 2027.</h2>
      <p class="sub" id="list">Sign up now and Lucid lands in your inbox the morning the doors open. Free.</p>
      <LucidSignup />
    </div>
  </section>
</Base>

<script is:inline>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('.gl video').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  // nights left until the doors open (Melbourne midnight); quietly hides itself once it's time
  (function () {
    var c = document.querySelector('.l-hero .count'); if (!c) return;
    var open = new Date(c.getAttribute('data-open')).getTime();
    var n = Math.ceil((open - Date.now()) / 86400000);
    var el = c.querySelector('.days');
    if (n > 1) { el.querySelector('.n').textContent = n; }
    else if (n === 1) { el.querySelector('.n').textContent = '1'; el.querySelector('.unit').textContent = 'night to go'; }
    else { el.style.visibility = 'hidden'; }
  })();
  // workstation switcher: panels share one grid cell, so switching never moves the page
  (function () {
    var tabs = document.querySelectorAll('.st-tab'), panels = document.querySelectorAll('.st-panel');
    tabs.forEach(function (t) { t.addEventListener('click', function () {
      tabs.forEach(function (x) { x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
      panels.forEach(function (p) { var on = p.getAttribute('data-st') === t.getAttribute('data-st'); p.classList.toggle('on', on); p.setAttribute('aria-hidden', on ? 'false' : 'true'); });
    }); });
  })();
</script>

<style>
  /* opal: pearl, lilac, aqua, blush, slowly shifting */
  .opal { background: linear-gradient(100deg, #FFF6EC, #F2C6E0 25%, #E2B8FF 45%, #9FE6F5 70%, #FFF6EC 90%); background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent; animation: opal 14s ease-in-out infinite alternate; }
  .aur { background: linear-gradient(100deg, #5CFFB0, #2EE6C8 40%, #4FB8FF 75%, #A98CFF); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @keyframes opal { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }

  .l-hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .l-hero .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .l-hero .fade { position: absolute; inset: auto 0 0 0; height: 30%; background: linear-gradient(transparent, var(--midnight)); }
  .l-copy { position: relative; padding-block: 140px 9vh; }
  .tag { display: flex; gap: 14px; align-items: center; font: 500 12px/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 18px; }
  .tag .soon { padding: 7px 12px; border: 1px solid rgba(242, 198, 224, .45); border-radius: 99px; color: #F6E4F4; }
  h1.opal { font: italic 400 clamp(96px, 16vw, 220px)/.9 var(--serif); margin: 0; }
  .line { font: italic 400 clamp(28px, 3.6vw, 48px)/1.15 var(--serif); color: #E9D8FF; margin: 14px 0 6px; }
  .lede { color: var(--ink-2); font-size: 18px; margin: 0 0 28px; max-width: 46ch; }
  .count .when { margin: 0; font: 500 12px/1.6 var(--sans); letter-spacing: .26em; text-transform: uppercase; color: #BFEFF7; }
  .count .when strong { color: var(--ink); font-weight: 500; }
  .count .days { margin: 6px 0 0; font: italic 400 22px/1 var(--serif); color: var(--ink-2); min-height: 1em; }
  .count .days .n { color: #F6E4F4; }

  .stars circle { animation: tw 5s ease-in-out infinite alternate; }
  .stars circle:nth-child(2n) { animation-delay: -2.4s; }
  .stars circle:nth-child(3n) { animation-delay: -1.1s; animation-duration: 7s; }
  @keyframes tw { from { opacity: .25; } to { opacity: .8; } }
  .breathe { animation: br 9s ease-in-out infinite alternate; transform-origin: 1360px 420px; }
  @keyframes br { from { opacity: .75; transform: scale(.96); } to { opacity: 1; transform: scale(1.04); } }
  .d { animation: bob 8s ease-in-out infinite alternate; transform-box: fill-box; }
  .d2 { animation-delay: -3s; } .d3 { animation-delay: -5s; } .d4 { animation-delay: -1.5s; } .d5 { animation-delay: -6s; } .d6 { animation-delay: -4s; }
  @keyframes bob { from { translate: 0 -6px; } to { translate: 0 8px; } }
  .shimmer { opacity: .18; animation: sh 6s ease-in-out infinite alternate; }
  @keyframes sh { from { opacity: .1; } to { opacity: .24; } }

  section h2 { font: italic 400 clamp(40px, 5.4vw, 76px)/1.05 var(--serif); margin: 0 0 16px; color: var(--ink); }
  .sub { color: var(--ink-2); font-size: 17px; line-height: 1.65; max-width: 58ch; margin: 0; }
  .eyebrow { color: #BFEFF7; }

  .l-glimpse { position: relative; padding-block: 40px 0; }
  .gl-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 44px); max-width: 860px; margin: 0 auto; align-items: end; }
  .gl { margin: 0; text-align: center; }
  .gl:nth-child(2) { transform: translateY(-26px); }
  .gl-door { position: relative; aspect-ratio: 3 / 5; border-radius: 999px 999px 14px 14px; overflow: hidden; border: 1px solid rgba(233, 216, 255, .22); box-shadow: 0 30px 80px -40px rgba(201, 188, 255, .55), inset 0 0 0 1px rgba(255, 246, 236, .04); background: #070B18; animation: gl-float 9s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -3s); }
  .gl-door video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gl figcaption { margin-top: 14px; font: 500 11px/1.4 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: rgba(233, 216, 255, .7); }
  @keyframes gl-float { from { translate: 0 0; } to { translate: 0 -8px; } }
  @media (max-width: 700px) { .gl-row { gap: 10px; } .gl, .gl:nth-child(2) { transform: none; } .gl figcaption { font-size: 9px; letter-spacing: .16em; } }
  .l-rooms { position: relative; padding-block: 120px 100px; overflow: hidden; }
  .l-rooms .halo.h1 { position: absolute; width: 640px; height: 640px; right: -160px; top: 220px; border-radius: 50%; background: #C9BCFF; filter: blur(110px); opacity: .12; pointer-events: none; }
  .doors { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; margin-top: 48px; align-items: end; }
  .door { position: relative; min-height: 300px; border-radius: 120px 120px 6px 6px; padding: 26px 20px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; overflow: hidden; }
  .door.content { background: rgba(20, 18, 62, .7); border: 1px solid var(--line); }
  .door.open-slot { border: 1px dashed rgba(191, 239, 247, .5); }
  .door .lab { font: 500 11px/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; color: #BFEFF7; }
  .door .nm { font: italic 400 32px/1.05 var(--serif); color: var(--ink); }
  .door .ln { font-size: 14px; line-height: 1.4; color: var(--ink-3); }
  .door .veil { position: absolute; inset: 0; display: grid; place-items: center; font: italic 400 22px/1 var(--serif); color: #F6E4F4; letter-spacing: .08em;
    background: linear-gradient(180deg, rgba(233, 216, 255, .14), rgba(159, 230, 245, .06) 60%, transparent); opacity: 0; transition: opacity .6s var(--ease); }
  .door.open-slot:hover .veil { opacity: 1; }
  .crafts { margin: 36px 0 0; font: italic 400 clamp(22px, 2.4vw, 32px)/1.45 var(--serif); color: #F2C6E0; max-width: 62ch; }

  .l-phases { padding-block: 100px; }
  .steps { list-style: none; padding: 0; margin: 52px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .steps li { display: flex; flex-direction: column; gap: 10px; transform: translateY(calc((3 - var(--i)) * 18px)); }
  .steps svg { width: 52px; height: 78px; }
  .steps .nm { font: italic 400 40px/1 var(--serif); color: var(--ink); }
  .steps .ln { color: var(--ink-2); font-size: 15px; }

  .l-stations { position: relative; padding-block: 100px; overflow: hidden; }
  .l-stations .halo.h2 { position: absolute; width: 560px; height: 560px; left: -180px; top: 120px; border-radius: 50%; background: #9FE6F5; filter: blur(120px); opacity: .09; pointer-events: none; }
  .st-tabs { display: inline-flex; flex-wrap: wrap; gap: 6px; margin-top: 40px; padding: 5px; border: 1px solid rgba(233, 216, 255, .18); border-radius: 99px; }
  .st-tab { appearance: none; background: none; border: 0; cursor: pointer; padding: 10px 18px; border-radius: 99px; font: 500 11px/1 var(--sans); letter-spacing: .22em; text-transform: uppercase; color: var(--ink-3); transition: color .3s, background .3s, box-shadow .3s; }
  .st-tab:hover { color: var(--ink); }
  .st-tab[aria-selected="true"] { color: #070B18; background: linear-gradient(100deg, #FFF6EC, #F2C6E0 35%, #E2B8FF 65%, #BFEFF7); box-shadow: 0 0 24px -6px rgba(233, 216, 255, .7); }
  .st-stage { display: grid; margin-top: 44px; }
