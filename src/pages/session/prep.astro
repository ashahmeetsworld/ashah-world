---
// Session prep form (23 Nov 2026, Ashah's pick: B, one question a screen). Not linked from the site:
// Cal.com sends people here after they book, with ?startTime=&attendeeName=&email= on the link.
// Answers go to the same inbox as the Apply form. Generated by src/session/prep.py.
import html from '../../session/prep.html?raw';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const out = html.replace(/^<!doctype html>/i, '').replaceAll('__BASE__', base);
---
<Fragment set:html={out} />
