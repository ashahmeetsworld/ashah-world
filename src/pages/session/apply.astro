---
// Apply for a Session (v2.0, live 23 Nov 2026): the screening form. Generated by src/session/apply_v2.py
// (v1.1 was build.py's). It keeps sending where the live form already sends; set APPLY_ENDPOINTS (comma-separated) to change that.
import html from '../../session/apply.html?raw';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const out = html.replace(/^<!doctype html>/i, '').replaceAll('__BASE__', base);
---
<Fragment set:html={out} />
