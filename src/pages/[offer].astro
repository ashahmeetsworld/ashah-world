---
// Sales pages. Each markdown file in src/content/offers becomes /<file-name>/
// Sales pages use their own darker charcoal stage (body.ub) to feel set apart.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Arrow from '../components/Arrow.astro';
import Flame from '../components/Flame.astro';
import Lighthouse from '../components/Lighthouse.astro';
import Everywhere from '../components/Everywhere.astro';
import site from '../data/site.json';
import { u } from '../lib/url';

export async function getStaticPaths() {
  const offers = await getCollection('offers', (e) => !e.data.draft);
  return offers.map((entry) => ({ params: { offer: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const book = site.bookingUrl || u('/contact/');
const ext = /^https?:/.test(book);
const flames = [0, 2, 3, 1];
---
<Base title={d.title} description={d.subhead} bodyClass="ub">
  <!-- ─── Hero: one light, everywhere ─── -->
  <section class="u-hero">
    <Everywhere />
    <div class="u-vignette"></div>
    <div class="wrap u-copy">
      {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
      <h1 class="word">{d.title}</h1>
      <p class="u-head">{d.headline}</p>
      <p class="u-sub">{d.subhead}</p>
      <div class="ctas">
        <a class="btn aurora" href={book} target={ext ? '_blank' : undefined} rel="noopener"><span>{d.cta.label}</span></a>
        <a class="go" href="#stack">See the stack <Arrow /></a>
      </div>
      <p class="u-note">Free 15–20 minute call · insight and pitch within 1–3 business days</p>
    </div>
  </section>

  <!-- ─── Founding partners ─── -->
  {d.founding && (
    <section class="pad founding-sec">
      <div class="wrap">
        <div class="founding rv">
          <div class="f-glow" aria-hidden="true"></div>
          <svg class="f-tinsel" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 300 C 200 270, 380 330, 600 296 S 1000 262, 1200 292" />
            <path d="M0 322 C 220 300, 420 352, 640 318 S 1020 290, 1200 316" />
            <path d="M0 346 C 240 330, 460 372, 680 342 S 1040 318, 1200 340" />
            <path d="M0 368 C 260 356, 480 392, 720 366 S 1060 346, 1200 364" />
          </svg>
          <div class="f-copy">
            <p class="eyebrow">The invitation</p>
            <h2>{d.founding.title}</h2>
            <p class="body">{d.founding.text}</p>
          </div>
          <div class="f-side">
            <ul>{d.founding.perks.map((p) => <li>{p}</li>)}</ul>
            <a class="btn aurora" href={book} target={ext ? '_blank' : undefined} rel="noopener"><span>Claim a founding spot</span></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ─── Tension ─── -->
  <section class="pad tension-sec">
    <div class="wrap">
      <div class="head rv">
        <p class="eyebrow">The tension</p>
        <h2>{d.problem.title}</h2>
      </div>
      <div class="tension">
        {d.problem.points.map((p, i) => (
          <div class="rv t" style={`transition-delay:${i * 90}ms`}>
            <svg viewBox="0 0 200 40" aria-hidden="true"><path d={['M0 26 C 30 2, 60 2, 90 26 S 150 50, 200 14', 'M0 22 C 25 10, 50 10, 75 22 S 125 34, 150 22 S 185 14, 200 20', 'M0 20 C 10 17, 20 17, 30 20 S 50 23, 60 20 S 80 17, 90 20 S 110 23, 120 20 S 140 17, 150 20 S 170 23, 180 20 S 195 18, 200 20'][i % 3]} fill="none" stroke="#5AAFE0" stroke-width="1.4" opacity=".55" class="wl" /></svg>
            <p class="label">{p.label}</p>
            <p class="txt">{p.text}</p>
          </div>
        ))}
      </div>
      {d.problem.thoughts.length > 0 && (
        <div class="voice">
          <p class="label vt rv">{d.problem.thoughtsTitle ?? 'You might be thinking'}</p>
          <div class="thoughts">
            {d.problem.thoughts.map((t, i) => (
              <div class="th rv" style={`transition-delay:${i * 90}ms`}>
                <p class="tq serif">{t.q}</p>
                <p class="ta">{t.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ─── Promise ─── -->
  <section class="pad promise">
    <div class="wrap grid-2">
      <div class="rv">
        <p class="eyebrow">The promise</p>
        <h2>{d.promise.title}</h2>
        <p class="body">{d.promise.text}</p>
        <ul class="beams">{d.promise.outcomes.map((o) => <li>{o}</li>)}</ul>
      </div>
      <div class="rv art"><Lighthouse /></div>
    </div>
  </section>

  <!-- ─── Before / after ─── -->
  {d.transformation && (
    <section class="pad shift">
      <div class="wrap">
        <div class="head rv center-head">
          <p class="eyebrow">What changes</p>
          <h2>{d.transformation.title}</h2>
        </div>
        <div class="ba rv">
          <div class="col before">
            <p class="label">Before</p>
            <ul>{d.transformation.before.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="arrow" aria-hidden="true"><span></span></div>
          <div class="col after">
            <p class="label">With Ubiquity</p>
            <ul>{d.transformation.after.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ─── Stack ─── -->
  <section class="pad stack-sec" id="stack">
    <div class="halo" style="width:760px;height:460px;left:50%;top:8%;transform:translateX(-50%);background:#8A2B3B;opacity:.5"></div>
    <div class="wrap">
      <div class="head rv center-head">
        <p class="eyebrow">The stack</p>
        <h2>Spark to wildfire.</h2>
        <p class="body">Content throws sparks, conversations give them kindling, a short call is the first flame. That leads to a launch, the launch earns the retainer, and collabs carry the embers to new audiences.</p>
      </div>
      <div class="tiers">
        {d.tiers.map((t, i) => (
          <article class={`tier rv ${t.highlight ? 'hl' : ''}`} style={`transition-delay:${i * 90}ms`}>
            {t.highlight && <span class="badge label">Where most start</span>}
            <Flame level={flames[i] ?? 1} />
            <p class="label stage">{t.stage}</p>
            <h3>{t.name}</h3>
            <p class="price">{t.price}</p>
            <p class="txt">{t.text}</p>
            {t.includes.length > 0 && <ul>{t.includes.map((x) => <li>{x}</li>)}</ul>}
          </article>
        ))}
      </div>
      <div class="mid-cta rv">
        <p class="serif">Every fire starts with a spark.</p>
        <a class="btn solid" href={book} target={ext ? '_blank' : undefined} rel="noopener">{d.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- ─── Fit + objections: one green thread ─── -->
  <section class="pad match">
    <div class="halo" style="width:620px;height:420px;left:-160px;top:6%;background:#45E992;opacity:.0"></div>
    <div class="wrap">
      <div class="head rv">
        <p class="eyebrow">Is this you?</p>
        <h2>Built for a certain kind of founder.</h2>
      </div>
      <div class="fit rv">
        <div>
          <p class="label g">This is for you if</p>
          <ul class="yes">{d.fit.yes.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div>
          <p class="label dim">It’s not for</p>
          <ul class="no">{d.fit.no.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      {d.objections.length > 0 && (
        <>
          <div class="thread rv" aria-hidden="true"><span></span><p class="label g">Still on the fence?</p><span></span></div>
          <div class="groups">
            {[['habit', 'Comfortable where you are?'], ['anxiety', 'Nervous about the leap?']].map(([g, title]) => (
              <div class="grp">
                <p class="gt serif rv">{title}</p>
                {d.objections.filter((o) => o.group === g).map((o) => (
                  <div class="o rv">
                    <p class="q serif">{o.q}</p>
                    <p class="a">{o.a}</p>
                  </div>
                ))}
              </div>
            ))}
          </div>
          {d.assurances && (
            <div class="assure rv">
              <div>
                <h3>{d.assurances.title}</h3>
                {d.assurances.text && <p class="body">{d.assurances.text}</p>}
              </div>
              <ul>{d.assurances.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
          <div class="mid-cta rv">
            <p class="serif">The only real risk is another quiet drop.</p>
            <a class="btn solid" href={book} target={ext ? '_blank' : undefined} rel="noopener">{d.cta.label}</a>
          </div>
        </>
      )}
    </div>
  </section>

  {entry.body?.trim() && <section class="wrap prose"><Content /></section>}

  <!-- ─── FAQ ─── -->
  {d.faq.length > 0 && (
    <section class="pad">
      <div class="wrap faq">
        <div class="rv">
          <p class="eyebrow">Questions</p>
          <h2>Before you ask.</h2>
        </div>
        <div class="rv qs">
          {d.faq.map((f) => (
            <details>
              <summary><span class="serif">{f.q}</span><i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── Close ─── -->
  <section class="o-cta" id="close">
    <div class="wrap rv o-cta-copy">
      <h2 class="big">{d.cta.title}</h2>
      <p class="lede">{d.cta.text}</p>
      <div class="ctas center">
        <a class="btn solid" href={book} target={ext ? '_blank' : undefined} rel="noopener">{d.cta.label}</a>
        <a class="go" href={u('/contact/')}>Or send a message <Arrow /></a>
      </div>
    </div>
    <div class="scene"><Sky variant="dawn" id="offer-dawn" /></div>
  </section>

  <!-- ─── Floating call to action ─── -->
  <div class="float" aria-hidden="true">
    <span class="serif">{d.title}</span>
    <a class="btn aurora sm" href={book} target={ext ? '_blank' : undefined} rel="noopener" tabindex="-1"><span>{d.cta.label}</span></a>
  </div>
</Base>
<script>
  // Show the floating call to action between the hero and the closing scene.
  const bar = document.querySelector('.float') as HTMLElement | null;
  const hero = document.querySelector('.u-hero');
  const close = document.getElementById('close');
  if (bar && hero && close && 'IntersectionObserver' in window) {
    let pastHero = false, atClose = false;
    const set = () => bar.classList.toggle('on', pastHero && !atClose);
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; set(); }).observe(hero);
    new IntersectionObserver(([e]) => { atClose = e.isIntersecting; set(); }).observe(close);
  }
</script>
<style>
  /* the stage: deeper charcoal, warm light */
  :global(body.ub) { --midnight: #09080D; --line: rgba(246, 232, 236, .1); background: #09080D; }

  .btn.solid { background: var(--peach); color: #140A0E; border-color: var(--peach); box-shadow: 0 0 0 0 rgba(242, 180, 140, .5); text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .btn.solid:hover { background: #FFE7C4; border-color: #FFE7C4; box-shadow: 0 0 50px rgba(242, 180, 140, .45); }
  .btn.aurora { position: relative; overflow: hidden; isolation: isolate; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; color: #071021; border: 0;
    background: linear-gradient(110deg, #7FD8F0, #8FB4F6 30%, #A996FF 55%, #7FD8F0 80%, #A9EAF7); background-size: 250% 100%;
    box-shadow: 0 0 30px rgba(127, 216, 240, .28), 0 0 60px rgba(156, 134, 255, .18); animation: au-btn 8s ease-in-out infinite alternate; transition: box-shadow .4s; }
  .btn.aurora span { position: relative; z-index: 1; }
  .btn.aurora::after { content: ''; position: absolute; inset: 0; z-index: 0; background: linear-gradient(100deg, transparent 35%, rgba(255, 255, 255, .55) 50%, transparent 65%); transform: translateX(-120%); animation: tinsel 5s ease-in-out infinite 1.5s; }
  .btn.aurora:hover { box-shadow: 0 0 46px rgba(127, 216, 240, .5), 0 0 90px rgba(156, 134, 255, .3); }
  @keyframes au-btn { to { background-position: 100% 0; } }
  @keyframes tinsel { 0% { transform: translateX(-120%); } 35%, 100% { transform: translateX(120%); } }
  .btn.sm { padding: 12px 18px; font-size: 11px; }

  /* hero */
  .u-hero { position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; padding: 120px 0 90px; text-align: center; }
  .u-vignette { position: absolute; inset: 0; background: radial-gradient(85% 75% at 50% 45%, transparent 50%, rgba(9, 8, 15, .35) 85%, rgba(9, 8, 13, .8) 100%), linear-gradient(180deg, transparent 95%, #09080D 100%); pointer-events: none; }
  .u-copy { position: relative; display: grid; justify-items: center; }
  .u-copy .eyebrow { color: #A9EAF7; text-shadow: 0 0 18px rgba(127, 216, 240, .55); }
  .word { font-size: clamp(64px, 13vw, 200px); line-height: .95; letter-spacing: -.01em; font-style: italic; font-weight: 400; margin: 6px 0 22px; color: #FFF6EC;
    text-shadow: 0 0 40px rgba(255, 231, 196, .4), 0 0 120px rgba(242, 180, 140, .25); animation: glow 6s ease-in-out infinite; }
  @keyframes glow { 50% { text-shadow: 0 0 60px rgba(255, 231, 196, .55), 0 0 160px rgba(242, 180, 140, .35); } }
  .u-head { font: italic 400 clamp(26px, 3.2vw, 42px)/1.15 var(--serif); margin: 0 0 18px; max-width: none; text-wrap: balance; }
  @media (min-width: 900px) { .u-head { white-space: nowrap; } }
  .u-sub { color: var(--ink-2); max-width: 54ch; margin: 0 0 34px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px 34px; align-items: center; }
  .u-copy .ctas, .ctas.center { justify-content: center; }
  .u-note { margin: 22px 0 0; font-size: 13px; color: var(--ink-3); letter-spacing: .04em; }


  .head { max-width: 760px; margin-bottom: clamp(44px, 6vw, 72px); }
  .head h2 { margin-bottom: 20px; }
  .center-head { margin-inline: auto; text-align: center; }
  .center-head .body { margin-inline: auto; }
  .tension { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .t svg { width: 100%; height: 40px; margin-bottom: 18px; }
  .tension-sec { background: linear-gradient(180deg, #09080D, #0A0C16 55%, #09080D); }
  .tension-sec .eyebrow { color: var(--peach); }
  .t .label { color: #8FC6E8; margin: 0 0 10px; }
  .voice { margin-top: clamp(64px, 8vw, 96px); }
  .vt { color: #8FC6E8; margin: 0 0 22px; }
  .thoughts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .th { padding: 26px 24px; border: 1px solid rgba(143, 198, 232, .14); background: rgba(10, 14, 26, .5); }
  .tq { font-size: 26px; line-height: 1.15; margin: 0 0 12px; color: #F2F6FA; }
  .tq::before { content: '“'; color: #8FC6E8; } .tq::after { content: '”'; color: #8FC6E8; }
  .ta { margin: 0; color: var(--ink-2); font-size: 15px; }
  .t svg { filter: none; }
  .wl { animation: wl 6s ease-in-out infinite alternate; }
  @keyframes wl { from { transform: translateX(-6px); } to { transform: translateX(6px); } }
  .txt { color: var(--ink-2); margin: 0; font-size: 15.5px; }

  .promise { background: linear-gradient(180deg, #09080D, #170D1C 50%, #09080D); }
  .grid-2 { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .grid-2 h2 { margin-bottom: 24px; }
  .art { box-shadow: 0 40px 120px -50px rgba(242, 180, 140, .35); }
  .beams { list-style: none; padding: 0; margin: 30px 0 0; }
  .beams li { font: italic clamp(24px, 2.4vw, 30px)/1.4 var(--serif); color: var(--peach); display: flex; align-items: center; gap: 16px; }
  .beams li::before { content: ''; width: 46px; height: 1px; background: linear-gradient(90deg, var(--peach), transparent); }

  /* before / after */
  .ba { display: grid; grid-template-columns: 1fr 80px 1fr; align-items: stretch; max-width: 1000px; margin: 0 auto; }
  .col { padding: 34px 32px; border: 1px solid var(--line); }
  .col ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 16px; }
  .col li { font: italic 22px/1.3 var(--serif); }
  .before { background: #0D0C12; }
  .before li { color: var(--ink-3); }
  .before .label { color: var(--ink-3); }
  .after { background: radial-gradient(120% 90% at 100% 0%, rgba(242, 180, 140, .16), #120B14 70%); border-color: rgba(242, 180, 140, .4); box-shadow: 0 30px 100px -50px rgba(242, 180, 140, .55); }
  .after .label { color: var(--peach); }
  .after li { color: #FFF6EC; padding-left: 22px; position: relative; }
  .after li::before { content: ''; position: absolute; left: 0; top: .6em; width: 8px; height: 8px; border-radius: 50%; background: var(--peach); box-shadow: 0 0 12px var(--peach); }
  .arrow { display: grid; place-items: center; }
  .arrow span { width: 44px; height: 1px; background: linear-gradient(90deg, transparent, var(--peach)); position: relative; }
  .arrow span::after { content: ''; position: absolute; right: 0; top: -4px; border-left: 8px solid var(--peach); border-top: 4.5px solid transparent; border-bottom: 4.5px solid transparent; }

  /* stack */
  .stack-sec { overflow: hidden; background: linear-gradient(180deg, #09080D, #1A0C14 50%, #09080D); }
  .stack-sec .price { color: var(--peach); }
  .stack-sec .eyebrow { color: var(--peach); }
  .tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; position: relative; }
  .tier { position: relative; padding: 30px 26px; border: 1px solid var(--line); background: rgba(9, 8, 13, .6); display: flex; flex-direction: column; }
  .tier.hl { border-color: rgba(242, 160, 150, .5); background: radial-gradient(120% 60% at 50% 0%, rgba(242, 170, 150, .15), rgba(9, 8, 13, .7) 70%); box-shadow: 0 30px 100px -50px rgba(242, 170, 150, .55); }
  .badge { position: absolute; top: -9px; left: 24px; background: var(--peach); color: #140A0E; padding: 4px 10px; font-size: 10px; letter-spacing: .2em; }
  .stage { color: #E88E98; margin: 16px 0 6px; }
  .tier h3 { font-size: 34px; }
  .price { font: 500 13px/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--peach); margin: 12px 0 16px; }
  .tier ul { list-style: none; padding: 18px 0 0; margin: 20px 0 0; border-top: 1px solid var(--line); display: grid; gap: 9px; }
  .tier li { font-size: 14.5px; color: var(--ink-2); padding-left: 20px; position: relative; }
  .tier li::before { content: ''; position: absolute; left: 0; top: .7em; width: 9px; height: 1px; background: #F06CC0; }
  .mid-cta { display: grid; justify-items: center; gap: 20px; margin-top: 64px; text-align: center; }
  .mid-cta .serif { font-size: clamp(26px, 3vw, 36px); margin: 0; }

  .match { overflow: hidden; background: linear-gradient(180deg, #09080D, #0A0B0D 50%, #09080D); }
  .match .eyebrow { color: var(--peach); }
  .label.g { color: #8FDDB2; }
  .fit { display: grid; grid-template-columns: 1.3fr 1fr; gap: 60px; }
  .fit .label { margin: 0 0 18px; }
  .thread { display: flex; align-items: center; gap: 18px; margin: clamp(64px, 8vw, 100px) 0 18px; }
  .thread span { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(143, 221, 178, .3), transparent); }
  .thread .label { margin: 0; white-space: nowrap; }
  .btn.solid.crimson { background: #D82A99; border-color: #D82A99; color: #FFF6EC; }
  .btn.solid.crimson:hover { background: #F06CC0; border-color: #F06CC0; box-shadow: 0 0 50px rgba(216, 42, 153, .45); }
  .btn.solid.green { background: #45E992; border-color: #45E992; color: #061A10; }
  .btn.solid.green:hover { background: #A8F5C8; border-color: #A8F5C8; box-shadow: 0 0 50px rgba(69, 233, 146, .45); }
  .fit ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .fit li { font: italic clamp(22px, 2.2vw, 28px)/1.35 var(--serif); padding-left: 34px; position: relative; }
  .yes li::before { content: ''; position: absolute; left: 0; top: .62em; width: 9px; height: 9px; border-radius: 50%; background: #8FDDB2; box-shadow: 0 0 10px rgba(143, 221, 178, .6); }
  .no li { color: var(--ink-3); }
  .no li::before { content: ''; position: absolute; left: 0; top: .7em; width: 14px; height: 1px; background: var(--ink-3); }
  .dim { color: var(--ink-3); }

  /* objections */
  .obj { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }
  .o { padding: 28px 0; border-top: 1px solid var(--line); }
  .q { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.15; margin: 0 0 12px; color: #FFF6EC; }
  .q::before { content: '“'; color: #8FDDB2; margin-right: 2px; }
  .q::after { content: '”'; color: #8FDDB2; }
  .a { color: var(--ink-2); margin: 0; max-width: 52ch; }
  .groups { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }
  .gt { font-size: clamp(24px, 2.4vw, 30px); color: #8FDDB2; margin: 0 0 8px; }
  .assure { margin-top: clamp(56px, 7vw, 84px); display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: center; padding: clamp(28px, 4vw, 48px); border: 1px solid rgba(143, 221, 178, .3); background: radial-gradient(100% 120% at 0% 0%, rgba(143, 221, 178, .07), rgba(9, 8, 13, .6) 60%); }
  .assure h3 { font-size: clamp(32px, 3.4vw, 44px); margin-bottom: 10px; }
  .assure .body { margin: 0; }
  .assure ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .assure li { padding-left: 30px; position: relative; font: italic 21px/1.3 var(--serif); }
  .assure li::before { content: ''; position: absolute; left: 1px; top: .32em; width: 13px; height: 7px; border-left: 1.5px solid #8FDDB2; border-bottom: 1.5px solid #8FDDB2; transform: rotate(-45deg); }

  /* founding */
