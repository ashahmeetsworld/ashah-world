---
// Night to dawn behind the story: stars that fade as the sky warms,
// and a sun just below the horizon at the end of the journey.
let seed = 53;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 110 }, () => ({ x: r() * 100, y: Math.pow(r(), 1.8) * 55, s: r() < 0.1 ? 2 : r() < 0.4 ? 1.3 : 0.9, d: (r() * 7).toFixed(2), dur: (4 + r() * 5).toFixed(2) }));
---
<div class="dawn" aria-hidden="true">
  <div class="stars">
    {stars.map((s) => <i style={`left:${s.x.toFixed(2)}%;top:${s.y.toFixed(2)}%;width:${s.s}px;height:${s.s}px;animation-delay:-${s.d}s;animation-duration:${s.dur}s`}></i>)}
  </div>
  <div class="sun"></div>
</div>
<style>
  .dawn { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .stars { overflow: hidden; }
  .stars { position: absolute; inset: 0; }
  .stars i { position: absolute; border-radius: 50%; background: #fff; opacity: .6; animation: tw 6s ease-in-out infinite; }
  @keyframes tw { 0%, 100% { opacity: .15; } 50% { opacity: .8; } }
  .sun { position: absolute; right: 8%; bottom: 3%; width: 760px; height: 760px; transform: translateY(50%); border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 228, 196, .14) 0%, rgba(242, 180, 140, .09) 22%, rgba(224, 140, 126, .05) 42%, transparent 68%);
    filter: blur(8px); animation: rise 14s ease-in-out infinite alternate; }
  @keyframes rise { from { transform: translateY(54%) scale(.98); opacity: .85; } to { transform: translateY(46%) scale(1.03); opacity: 1; } }
  .horizon { position: absolute; left: 0; right: 0; bottom: 3%; height: 1px; background: linear-gradient(90deg, transparent, rgba(242, 180, 140, .35) 55%, rgba(242, 180, 140, .5) 78%, transparent); }
  @media (max-width: 760px) { .sun { right: -30%; width: 520px; height: 520px; } }
</style>
