---
// The door from the deck: an arched doorway open onto the world behind it.
// Moon over the city, a glowing pool, a lamp left on.
let seed = 9;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const L = 150, R = 370, TOP = 70, BOT = 440, HZN = 250;
const stars = Array.from({ length: 30 }, () => ({ x: L + 8 + r() * (R - L - 16), y: TOP + 40 + r() * (HZN - TOP - 70), s: r() < 0.2 ? 1.3 : 0.75, d: (r() * 5).toFixed(2) }));
const city = (x0: number, x1: number) => { const out: { x: number; w: number; h: number }[] = []; let x = x0; while (x < x1) { const w = 7 + r() * 9; out.push({ x, w, h: 8 + r() * 26 }); x += w + 1; } return out; };
const towers = [...city(L, L + 62), ...city(R - 66, R)];
---
<svg class="door" viewBox="0 0 520 520" role="img" aria-label="An arched door open onto a night world: moon over the city and a glowing pool">
  <defs>
    <clipPath id="dr-in"><path d={`M${L} ${BOT} L${L} ${TOP + 80} Q ${L} ${TOP} ${(L + R) / 2} ${TOP} Q ${R} ${TOP} ${R} ${TOP + 80} L ${R} ${BOT} Z`} /></clipPath>
    <linearGradient id="dr-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#090E26" />
      <stop offset=".35" stop-color="#16246A" />
      <stop offset=".7" stop-color="#2E2470" />
      <stop offset=".9" stop-color="#5A3478" />
      <stop offset="1" stop-color="#8A4C8E" />
    </linearGradient>
    <linearGradient id="dr-pool" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9EDCF2" stop-opacity=".9" />
      <stop offset=".08" stop-color="#5AA6DC" />
      <stop offset=".35" stop-color="#2D5DB0" />
      <stop offset=".7" stop-color="#28307E" />
      <stop offset="1" stop-color="#2A1F62" />
    </linearGradient>
    <radialGradient id="dr-moon" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#FFFFFF" /><stop offset=".55" stop-color="#F4F7FF" /><stop offset="1" stop-color="#DCE6FF" /></radialGradient>
    <radialGradient id="dr-halo"><stop offset="0" stop-color="#CFE3FF" stop-opacity=".45" /><stop offset="1" stop-color="#CFE3FF" stop-opacity="0" /></radialGradient>
    <radialGradient id="dr-lamp"><stop offset="0" stop-color="#F2B48C" stop-opacity=".75" /><stop offset="1" stop-color="#F2B48C" stop-opacity="0" /></radialGradient>
    <radialGradient id="dr-out" cx="260" cy="260" r="260" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#3C8FE0" stop-opacity=".22" /><stop offset="1" stop-color="#3C8FE0" stop-opacity="0" /></radialGradient>
    <linearGradient id="dr-spill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C7D6FF" stop-opacity=".32" /><stop offset=".5" stop-color="#A88BD8" stop-opacity=".12" /><stop offset="1" stop-color="#A88BD8" stop-opacity="0" /></linearGradient>
    <radialGradient id="dr-haze" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#E08C7E" stop-opacity=".45" /><stop offset=".5" stop-color="#8A4C8E" stop-opacity=".2" /><stop offset="1" stop-color="#8A4C8E" stop-opacity="0" /></radialGradient>
    <radialGradient id="dr-shim" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#7FD8F0" stop-opacity=".5" /><stop offset="1" stop-color="#7FD8F0" stop-opacity="0" /></radialGradient>
    <linearGradient id="dr-sea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3A2A74" /><stop offset="1" stop-color="#1D2766" /></linearGradient>
    <linearGradient id="dr-floor" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1A1A4E" /><stop offset="1" stop-color="#0E0E2C" /></linearGradient>
    <linearGradient id="dr-frame" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C9DCF7" /><stop offset=".6" stop-color="#9FB6EC" /><stop offset="1" stop-color="#B49AD8" /></linearGradient>
    <filter id="dr-mist" x="-30%" y="-100%" width="160%" height="300%"><feGaussianBlur stdDeviation="10" /></filter>
    <filter id="dr-soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7" /></filter>
  </defs>

  <path class="spill" d={`M${L} ${BOT} L${R} ${BOT} L${R + 90} 520 L${L - 90} 520 Z`} fill="url(#dr-spill)" filter="url(#dr-soft)" />

  <g clip-path="url(#dr-in)">
    <rect x={L} y={TOP} width={R - L} height={HZN - TOP} fill="url(#dr-sky)" />
    {stars.map((s) => <circle class="tw" style={`animation-delay:-${s.d}s`} cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.s} fill="#fff" />)}
    <circle class="halo" cx="318" cy="132" r="64" fill="url(#dr-halo)" />
    <circle cx="318" cy="132" r="17" fill="url(#dr-moon)" />
    <ellipse cx={(L + R) / 2} cy={HZN - 6} rx="150" ry="46" fill="url(#dr-haze)" />
    <g fill="#0B0E2C">{towers.map((t) => <rect x={t.x.toFixed(1)} y={(HZN - t.h).toFixed(1)} width={t.w.toFixed(1)} height={t.h.toFixed(1)} />)}</g>
    <g fill="#F2DDB4" opacity=".85">{towers.filter((_, i) => i % 2 === 0).map((t) => <rect x={(t.x + 2).toFixed(1)} y={(HZN - t.h + 4).toFixed(1)} width="2" height="2" />)}</g>
    <rect x={L} y={HZN} width={R - L} height="20" fill="url(#dr-sea)" />
    <g stroke="#DCEBFF" stroke-opacity=".6" stroke-linecap="round"><line x1="282" y1={HZN + 6} x2="318" y2={HZN + 6} /><line x1="290" y1={HZN + 12} x2="330" y2={HZN + 12} /></g>
    <rect x={L} y={HZN + 20} width={R - L} height="110" fill="url(#dr-pool)" />
    <ellipse class="mist" cx={(L + R) / 2} cy={HZN + 22} rx="140" ry="12" fill="#BFD9FF" opacity=".28" filter="url(#dr-mist)" />
    <ellipse cx="318" cy={HZN + 70} rx="30" ry="44" fill="url(#dr-shim)" opacity=".6" />
    <ellipse cx={(L + R) / 2} cy={HZN + 125} rx="150" ry="22" fill="#8A4C8E" opacity=".35" filter="url(#dr-mist)" />
    <g stroke="#E6F7FF" stroke-opacity=".16"><line x1={L} y1={HZN + 52} x2={R} y2={HZN + 52} /><line x1={L} y1={HZN + 78} x2={R} y2={HZN + 78} /><line x1={L} y1={HZN + 104} x2={R} y2={HZN + 104} /></g>
    <rect x={L} y={HZN + 130} width={R - L} height={BOT - HZN - 130} fill="url(#dr-floor)" />
    <g fill="#060B22">
      <path d={`M182 ${BOT - 26} L232 ${BOT - 26} L244 ${BOT - 44} L248 ${BOT - 42} L238 ${BOT - 22} L182 ${BOT - 22} Z`} /><rect x="186" y={BOT - 22} width="3" height="14" /><rect x="228" y={BOT - 22} width="3" height="14" />
      <path d={`M262 ${BOT - 26} L312 ${BOT - 26} L324 ${BOT - 44} L328 ${BOT - 42} L318 ${BOT - 22} L262 ${BOT - 22} Z`} /><rect x="266" y={BOT - 22} width="3" height="14" /><rect x="308" y={BOT - 22} width="3" height="14" />
    </g>
    <circle class="lamp" cx="348" cy={BOT - 92} r="36" fill="url(#dr-lamp)" />
    <path d={`M340 ${BOT - 98} L356 ${BOT - 98} L352 ${BOT - 88} L344 ${BOT - 88} Z`} fill="#E8B48A" />
    <rect x="347" y={BOT - 88} width="2" height="82" fill="#060B22" />
  </g>

  <!-- frame, and the door swung open to the right -->
  <path d={`M${L} ${BOT} L${L} ${TOP + 80} Q ${L} ${TOP} ${(L + R) / 2} ${TOP} Q ${R} ${TOP} ${R} ${TOP + 80} L ${R} ${BOT}`} fill="none" stroke="url(#dr-frame)" stroke-width="5" stroke-opacity=".9" />
  <path d={`M${R} ${TOP + 80} L ${R + 44} ${TOP + 108} L ${R + 44} ${BOT - 8} L ${R} ${BOT}`} fill="#0E0C2C" stroke="#A9B4E8" stroke-opacity=".55" stroke-width="2" />
  <line x1="40" y1={BOT} x2="480" y2={BOT} stroke="#9FC4F2" stroke-opacity=".1" />
  <!-- someone at the threshold -->
  <g fill="#050816"><circle cx="178" cy={BOT - 46} r="8.5" /><path d={`M168 ${BOT - 36} L188 ${BOT - 36} L192 ${BOT + 8} L164 ${BOT + 8} Z`} /></g>
</svg>
<style>
  .door { width: 100%; max-width: 440px; height: auto; display: block; overflow: visible; }
  .halo, .lamp { transform-box: fill-box; transform-origin: center; animation: breathe 7s ease-in-out infinite; }
  .mist { animation: spill 9s ease-in-out infinite; }
  .spill { animation: spill 7s ease-in-out infinite; }
  .tw { animation: tw 4s ease-in-out infinite; }
  .bob { animation: bob 3.6s ease-in-out infinite; }
  @keyframes breathe { 0%, 100% { opacity: .8; transform: scale(1); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes spill { 0%, 100% { opacity: .75; } 50% { opacity: 1; } }
  @keyframes tw { 50% { opacity: .2; } }
  @keyframes bob { 50% { transform: translateY(1.5px); } }
</style>
