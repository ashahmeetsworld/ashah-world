---
// A soft, humming light: layered glows that breathe and drift,
// with tiny motes rising through it like effervescence.
let seed = 77;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const motes = Array.from({ length: 18 }, () => ({
  x: 6 + r() * 60, s: 1.5 + r() * 3, d: (r() * 12).toFixed(2), dur: (9 + r() * 9).toFixed(2), drift: (r() * 40 - 20).toFixed(0),
}));
---
<div class="lum" aria-hidden="true">
  <span class="orb o1"></span>
  <span class="orb o2"></span>
  <span class="orb o3"></span>
  <span class="core"></span>
</div>
<style>
  .lum { position: absolute; left: -22%; top: 8%; width: 1000px; height: 1100px; pointer-events: none; z-index: 0; opacity: .72; }
  .orb, .core { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .o1 { inset: 12% 18%; background: radial-gradient(circle, rgba(3, 162, 255, .22), rgba(3, 162, 255, 0) 65%); filter: blur(60px); animation: breathe 7s ease-in-out infinite, drift1 19s ease-in-out infinite alternate; }
  .o2 { inset: 34% 4% 0% 22%; background: radial-gradient(circle, rgba(127, 216, 240, .16), rgba(127, 216, 240, 0) 65%); filter: blur(80px); animation: breathe 9s ease-in-out infinite -3s, drift2 23s ease-in-out infinite alternate; }
  .o3 { inset: 4% 34% 30% 6%; background: radial-gradient(circle, rgba(124, 92, 255, .15), rgba(124, 92, 255, 0) 65%); filter: blur(90px); animation: breathe 11s ease-in-out infinite -6s, drift1 27s ease-in-out infinite alternate-reverse; }
  .core { left: 38%; top: 30%; width: 120px; height: 120px; background: radial-gradient(circle, rgba(238, 250, 255, .34), rgba(127, 216, 240, .1) 45%, transparent 70%); filter: blur(10px); animation: hum 4.5s ease-in-out infinite; }
  .lum i { position: absolute; bottom: 30%; border-radius: 50%; background: #EAF8FF; box-shadow: 0 0 8px rgba(127, 216, 240, .7); opacity: 0; animation: rise 12s linear infinite; }
  @keyframes breathe { 0%, 100% { opacity: .7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.12); } }
  @keyframes drift1 { from { translate: -20px 10px; } to { translate: 30px -20px; } }
  @keyframes drift2 { from { translate: 20px -10px; } to { translate: -30px 20px; } }
  @keyframes hum { 0%, 100% { opacity: .55; transform: scale(.94); } 50% { opacity: .95; transform: scale(1.06); } }
  @keyframes rise { 0% { opacity: 0; transform: translate(0, 0); } 15% { opacity: .6; } 70% { opacity: .4; } 100% { opacity: 0; transform: translate(var(--dx), -360px); } }
  @media (max-width: 860px) { .lum { left: -40%; width: 720px; height: 900px; top: 10%; } }
</style>
