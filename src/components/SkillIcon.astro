---
interface Props { skill: string; }
const { skill } = Astro.props;
---
<svg viewBox="0 0 120 120" class="si" aria-hidden="true">
  {skill === 'Creative Direction' && (
    <g>
      <circle cx="60" cy="60" r="44" fill="var(--cd)" opacity=".16" />
      <path d="M60 22 L65 55 L98 60 L65 65 L60 98 L55 65 L22 60 L55 55 Z" fill="#fff" />
      <circle cx="60" cy="60" r="6" fill="#fff" />
    </g>
  )}
  {skill === 'Ecosystem Design' && (
    <g stroke="var(--eco)" stroke-width="2.4" fill="none" stroke-linecap="round">
      <path d="M60 104 V62 M60 74 L40 52 M40 52 V36 M40 52 L28 44 M60 70 L82 48 M82 48 V30 M82 48 L94 40 M60 62 V40 M60 40 L52 28 M60 40 L68 26" />
      {[[40, 34], [28, 42], [82, 28], [94, 38], [52, 26], [68, 24]].map(([x, y]) => <circle cx={x} cy={y} r="3.4" fill="var(--eco)" stroke="none" />)}
    </g>
  )}
  {skill === 'Cultural Leadership' && (
    <g>
      {[[30, 40], [52, 30], [78, 44], [92, 70], [66, 64], [40, 76], [24, 62], [56, 92], [84, 92]].map(([x, y], i) => (
        <g><circle cx={x} cy={y} r="9" fill="var(--cul)" opacity=".18" /><circle cx={x} cy={y} r="3" fill={i % 3 === 0 ? '#fff' : 'var(--cul)'} /></g>
      ))}
    </g>
  )}
  {skill === 'Campaign Marketing' && (
    <g stroke-linecap="round">
      {[[24, 20, 70], [46, 14, 56], [70, 24, 62], [36, 50, 46], [64, 58, 40]].map(([x, y, l], i) => (
        <g><line x1={x} y1={y} x2={x + l * .7} y2={y + l * .7} stroke="var(--cam)" stroke-width="2" opacity={.35 + i * .1} /><circle cx={x + l * .7} cy={y + l * .7} r="2.8" fill="#fff" /></g>
      ))}
    </g>
  )}
</svg>
<style>.si { width: 100%; height: 100%; overflow: visible; }</style>
