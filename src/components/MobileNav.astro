---
// Floating nav for phones (hidden above 760px, where the header nav does the job).
// On the home page Work and Feed jump to their sections and light up as you scroll past them;
// on every other page they open the Work page and the home feed.
import { u } from '../lib/url';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const home = path === '/' || path === '';
const items = [
  { key: 'home', label: 'Home', href: home ? '#top' : u('/'), icon: 'M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z' },
  { key: 'work', label: 'Work', href: home ? '#work' : u('/work/'), icon: 'M4 6.5h16v12H4zM9 6.5V5h6v1.5M4 11.5h16' },
  { key: 'feed', label: 'Feed', href: home ? '#feed' : u('/#feed'), icon: 'M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z' },
  { key: 'about', label: 'About', href: u('/about/'), icon: 'M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5' },
  { key: 'contact', label: 'Say hi', href: u('/contact/'), icon: 'M4 6h16v11H8l-4 3.5zM8 10.5h8M8 13.5h5' },
];
const current = home ? 'home' : path.startsWith('/work') ? 'work' : path.startsWith('/about') ? 'about' : path.startsWith('/contact') ? 'contact' : '';
---
<nav class="mnav" aria-label="Quick nav" data-home={home ? '1' : undefined}>
  {items.map((it) => (
    <a href={it.href} data-key={it.key} aria-current={it.key === current ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={it.icon} /></svg>
      <span>{it.label}</span>
    </a>
  ))}
</nav>
<style>
  .mnav { display: none; }
  @media (max-width: 760px) {
    .mnav { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; z-index: 60;
      left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      padding: 6px; border-radius: 22px; border: 1px solid var(--line);
      background: rgba(11, 18, 48, .72); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2);
      box-shadow: 0 18px 50px -12px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .05); }
    .mnav a { display: grid; justify-items: center; gap: 3px; padding: 8px 0 6px; border-radius: 16px; color: var(--ink-3); transition: color .3s, background .3s; }
    .mnav span { font: 500 9.5px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; }
    .mnav a[aria-current] { color: var(--peach); background: rgba(242, 180, 140, .08); }
    .mnav a[aria-current] svg { filter: drop-shadow(0 0 6px rgba(242, 180, 140, .6)); }
  }
</style>
<script>
  // Home page: light up the section you're in.
  const nav = document.querySelector<HTMLElement>('.mnav[data-home]');
  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const set = (key: string) => links.forEach((a) => (a.dataset.key === key ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
    const sections = ['work', 'feed'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const update = () => {
      const mid = innerHeight * 0.45;
      const hit = sections.find((s) => { const r = s.getBoundingClientRect(); return r.top <= mid && r.bottom > mid; });
      set(hit ? hit.id : 'home');
    };
    addEventListener('scroll', update, { passive: true });
    update();
    nav.querySelector('a[href="#top"]')?.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
  }
</script>
