---
// 0 = spark, 1 = embers, 2 = bonfire, 3 = hearth — size grows with the stage
interface Props { level?: number; }
const { level = 0 } = Astro.props;
const s = [0.42, 0.6, 1, 0.8][level] ?? 1;
---
<svg viewBox="0 0 80 100" class="fl" aria-hidden="true" style={`--s:${s}`}>
  <defs>
    <radialGradient id={`fg${level}`} cx=".5" cy=".75" r=".6"><stop offset="0" stop-color="#FFE7C4"/><stop offset=".45" stop-color="#F2B48C"/><stop offset="1" stop-color="#E08C7E"/></radialGradient>
    <radialGradient id={`fh${level}`}><stop offset="0" stop-color="#F2B48C" stop-opacity=".55"/><stop offset="1" stop-color="#E08C7E" stop-opacity="0"/></radialGradient>
  </defs>
  <g transform={`translate(40 92) scale(${s}) translate(-40 -92)`}>
    <circle cx="40" cy="64" r="40" fill={`url(#fh${level})`} class="fh"/>
    {level === 0 ? (
      [[40, 70, 3], [30, 58, 2], [50, 50, 2.4], [36, 40, 1.6]].map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#FFE7C4" class="sp"/>)
    ) : (
      <g class="lick">
        <path d="M40 92 C 18 92, 14 70, 26 56 C 28 66, 34 66, 34 58 C 34 44, 44 34, 42 16 C 58 30, 66 50, 62 66 C 60 58, 56 56, 54 60 C 64 74, 58 92, 40 92 Z" fill={`url(#fg${level})`}/>
        <path d="M40 92 C 30 92, 28 80, 34 72 C 36 78, 40 78, 40 72 C 40 66, 44 62, 46 58 C 52 68, 54 80, 48 88 C 46 90, 44 92, 40 92 Z" fill="#FFF4E3" opacity=".9"/>
      </g>
    )}
    {level === 3 && <rect x="8" y="90" width="64" height="6" rx="2" fill="#2A1A4E"/>}
  </g>
</svg>
<style>
  .fl { width: 64px; height: 80px; overflow: visible; }
  .lick { transform-origin: 40px 92px; animation: lick 2.4s ease-in-out infinite alternate; }
  .fh { animation: fh 3s ease-in-out infinite alternate; }
  .sp { animation: fh 1.6s ease-in-out infinite alternate; }
  @keyframes lick { from { transform: scale(1, 1) skewX(-2deg); } to { transform: scale(.96, 1.05) skewX(2deg); } }
  @keyframes fh { from { opacity: .55; } to { opacity: 1; } }
</style>
