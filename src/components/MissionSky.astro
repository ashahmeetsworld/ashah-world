---
// Quiet frame for the mission: stars that twinkle around the words,
// and slow ripples of light underneath. Keeps the centre clear.
let seed = 41;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const W = 1440, H = 640;
const stars = Array.from({ length: 90 }, () => {
  let x = 0, y = 0;
  do { x = r() * W; y = r() * H; } while (Math.abs(x - W / 2) < 360 && y > 90 && y < 470);
  return { x, y, s: r() < 0.12 ? 1.8 : r() < 0.4 ? 1.1 : 0.7, d: (r() * 7).toFixed(2), dur: (4 + r() * 5).toFixed(2), bright: r() < 0.1 };
});
const waves = [0, 1, 2, 3].map((i) => ({ y: 572 + i * 16, o: 0.32 - i * 0.06, d: (i * 1.7).toFixed(1), amp: 6 + i * 2 }));
---
<svg class="ms" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="ms-w" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7FD8F0" stop-opacity="0" />
      <stop offset=".5" stop-color="#F2B48C" stop-opacity="1" />
      <stop offset="1" stop-color="#7FD8F0" stop-opacity="0" />
    </linearGradient>
  </defs>
  {stars.map((s) => (
    <g class="tw" style={`animation-delay:-${s.d}s;animation-duration:${s.dur}s`}>
      {s.bright
        ? <path d={`M${s.x} ${s.y - 7} L${s.x + 1.4} ${s.y - 1.4} L${s.x + 7} ${s.y} L${s.x + 1.4} ${s.y + 1.4} L${s.x} ${s.y + 7} L${s.x - 1.4} ${s.y + 1.4} L${s.x - 7} ${s.y} L${s.x - 1.4} ${s.y - 1.4} Z`} fill="#FFF6EC" />
        : <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.s} fill="#fff" />}
    </g>
  ))}
  {waves.map((w) => (
    <path class="wv" style={`animation-delay:-${w.d}s`} opacity={w.o}
      d={`M240 ${w.y} C 480 ${w.y - w.amp}, 720 ${w.y + w.amp}, 960 ${w.y} S 1200 ${w.y - w.amp}, 1200 ${w.y}`}
      fill="none" stroke="url(#ms-w)" stroke-width="1.4" stroke-linecap="round" />
  ))}
</svg>
<style>
  .ms { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .tw { animation: tw 6s ease-in-out infinite; }
  @keyframes tw { 0%, 100% { opacity: .15; } 50% { opacity: .95; } }
  .wv { animation: wv 9s ease-in-out infinite alternate; }
  @keyframes wv { from { transform: translateX(-24px); } to { transform: translateX(24px); } }
</style>
