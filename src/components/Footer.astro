---
import site from '../data/site.json';
import { u } from '../lib/url';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();
---
<footer>
  <hr class="rule" />
  <div class="wrap foot">
    <div>
      <p class="mono">{site.monogram}</p>
      <p class="tag">{site.tagline}. {site.location}.</p>
      <div class="icons"><SocialIcons /></div>
    </div>
    <div class="nav-col">
    <div class="links">
      <a href={u('/work/')}>Work</a>
      <a href={u('/about/')}>About</a>
      {/* <a href={u('/ubiquity/')}>Ubiquity</a>  archived 15 Oct 2026 */}
      <a href={u('/contact/')}>Contact</a>
      {/* <a href={u('/community/')}>Community</a>  hidden 17 Oct 2026; page kept as src/pages/_community.astro */}
    </div>
    {/* second row: magnets, offers and ventures */}
    <div class="links ventures">
      <a class="passage-link" href={u('/passage/')}>Passage</a>
      <a class="orbit-link" href={u('/orbit/')}>Orbit</a>
      {/* Lucid (coming soon, doors open 4 Jan 2027): footer only, never the header. Hover pops a tiny "Coming soon" above it with a spark burst. */}
      <span class="lucid-wrap">
        <a class="lucid-link" href={u('/lucid/')}>Lucid</a>
        <span class="smoke" aria-hidden="true"><span>Coming soon</span></span>
      </span>
    </div>
    </div>
  </div>
  <div class="wrap legal"><span>© {year} {site.name}</span><span>Every frame is a place you could step into.</span></div>
</footer>
<style>
  footer { position: relative; padding-bottom: 40px; background: var(--midnight); }
  .foot { display: flex; justify-content: space-between; gap: 40px; padding-block: 56px 40px; flex-wrap: wrap; }
  .mono { font: italic 400 34px/1 var(--serif); margin: 0 0 10px; }
  .tag { margin: 0; color: var(--ink-3); font-size: 14px; }
  .icons { margin-top: 22px; }
  /* two rows on the page's right margin (desktop): site links, then magnets, offers and ventures; Orbit sits under Contact */
  .nav-col { display: flex; flex-direction: column; align-items: flex-end; }
  .links { display: flex; flex-wrap: wrap; gap: 14px 30px; align-items: flex-start; justify-content: flex-end; }
  @media (max-width: 700px) {
    /* phone: the footer stacks, so both rows sit on the left margin */
    .nav-col { align-items: flex-start; }
    .links { justify-content: flex-start; }
  }
  .ventures { margin-top: 12px; }
  .links a { font: 500 12px/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--ink-2); padding: 6px 0; }
  .links a:hover { color: var(--peach); }
  /* Orbit (the free OS): aurora colours, still */
  .links a.orbit-link { font: 500 12px/1 var(--sans); letter-spacing: .2em; text-transform: uppercase;
    background: linear-gradient(100deg, #5CFFB0, #2EE6C8 35%, #4FB8FF 70%, #A98CFF); -webkit-background-clip: text; background-clip: text; color: transparent; transition: filter .3s; }
  /* Passage (the offer): nocturnal blue-violet, sits left of Orbit */
  .links a.passage-link { background: linear-gradient(100deg, #A185FF, #8C57F8 50%, #C07FFF); -webkit-background-clip: text; background-clip: text; color: transparent; transition: filter .3s; }
  .passage-link:hover { filter: brightness(1.2) drop-shadow(0 0 8px rgba(142, 98, 247, .6)); }
  .orbit-link:hover { filter: brightness(1.2) drop-shadow(0 0 8px rgba(46, 230, 200, .45)); }
  /* Lucid (coming soon): opal colours that slowly shift */
  .links a.lucid-link { background: linear-gradient(100deg, #FFC4E4, #E2B8FF 35%, #9FE6F5 70%, #F2A8D8); background-size: 160% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent; transition: filter .3s; animation: lucid-opal 10s ease-in-out infinite alternate; }
  .lucid-link:hover { filter: brightness(1.15) drop-shadow(0 0 8px rgba(233, 216, 255, .45)); }
  @keyframes lucid-opal { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }
  /* the "Coming soon" pop-up: tiny, above the link (absolutely placed, nothing moves), a little spark burst, held ~1.8s, then it drifts off */
  .lucid-wrap { position: relative; display: flex; }
  .smoke { position: absolute; left: 50%; bottom: calc(100% - 2px); translate: -50% 0; pointer-events: none; white-space: nowrap; opacity: 0; }
  .smoke span { position: relative; display: block; font: 500 8.5px/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; color: #F6E4F4;
    text-shadow: 0 0 6px rgba(242, 198, 224, .7), 0 0 14px rgba(201, 188, 255, .4); }
  .smoke::before, .smoke::after { content: ''; position: absolute; left: 50%; top: 50%; width: 2.5px; height: 2.5px; border-radius: 50%; opacity: 0; }
  .smoke::before { box-shadow: 0 0 #F2C6E0, 0 0 #9FE6F5, 0 0 #E2B8FF, 0 0 #FFF6EC, 0 0 #F2C6E0, 0 0 #9FE6F5; }
  .smoke::after { box-shadow: 0 0 #E2B8FF, 0 0 #FFF6EC, 0 0 #9FE6F5, 0 0 #F2C6E0; }
  .lucid-wrap:hover .smoke, .lucid-link:focus-visible + .smoke { animation: lucid-pop 3.2s var(--ease) forwards; }
  .lucid-wrap:hover .smoke::before, .lucid-link:focus-visible + .smoke::before { animation: lucid-spark-a 1.1s ease-out forwards; }
  .lucid-wrap:hover .smoke::after, .lucid-link:focus-visible + .smoke::after { animation: lucid-spark-b 1.2s .08s ease-out forwards; }
  @keyframes lucid-pop {
    0%   { opacity: 0; transform: translateY(6px) scale(.9); filter: blur(4px); }
    16%  { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    72%  { opacity: 1; transform: translateY(-1px); filter: blur(0); }
    100% { opacity: 0; transform: translateY(-10px); filter: blur(5px); }
  }
  @keyframes lucid-spark-a {
    0%   { opacity: 1; box-shadow: 0 0 #F2C6E0, 0 0 #9FE6F5, 0 0 #E2B8FF, 0 0 #FFF6EC, 0 0 #F2C6E0, 0 0 #9FE6F5; }
    100% { opacity: 0; box-shadow: -34px -10px #F2C6E0, -18px -16px #9FE6F5, 0 -18px #E2B8FF, 18px -16px #FFF6EC, 34px -10px #F2C6E0, 40px 2px #9FE6F5; }
  }
  @keyframes lucid-spark-b {
    0%   { opacity: 1; box-shadow: 0 0 #E2B8FF, 0 0 #FFF6EC, 0 0 #9FE6F5, 0 0 #F2C6E0; }
    100% { opacity: 0; box-shadow: -42px 0 #E2B8FF, -26px -8px #FFF6EC, 26px -8px #9FE6F5, 10px -14px #F2C6E0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .links a.lucid-link { animation: none; }
    .smoke::before, .smoke::after { display: none; }
  }
  .legal { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 12px; color: var(--ink-3); }
  .legal span:last-child { font: italic 15px/1.2 var(--serif); }
</style>
