---
// The night passes (sandbox, 30 Oct 2026): the home page is one night, from midnight at the hero to first light
// at "Letters from the world". A fixed sky sits behind every section and warms as you scroll; the stars fade out.
// Phones also get a thin line of light along the top that warms as the night passes.
---
<div class="np" aria-hidden="true">
  <div class="np-sky"></div>
  <canvas class="np-stars"></canvas>
  <div class="np-glow"></div>
</div>
<div class="np-line" aria-hidden="true"></div>

<script>
  const root = document.documentElement;
  const end = document.getElementById('letters');
  // sky colours through the night: [p, top, bottom, horizon glow alpha]
  const STOPS: [number, number[], number[], number][] = [
    [0, [7, 11, 24], [7, 11, 24], 0],
    [0.5, [8, 12, 32], [14, 24, 66], 0],
    [0.8, [12, 10, 38], [34, 22, 78], 0.03],
    [1, [18, 12, 42], [58, 34, 92], 0.1],
  ];
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
  const at = (p: number) => {
    let i = 0;
    while (i < STOPS.length - 2 && p > STOPS[i + 1][0]) i++;
    const [p0, t0, b0, g0] = STOPS[i], [p1, t1, b1, g1] = STOPS[i + 1];
    const t = Math.min(1, Math.max(0, (p - p0) / (p1 - p0)));
    return { top: mix(t0, t1, t), bot: mix(b0, b1, t), glow: g0 + (g1 - g0) * t };
  };

  let ticking = false;
  const update = () => {
    ticking = false;
    if (!end) return;
    const stop = end.getBoundingClientRect().top + scrollY - innerHeight * 0.3;
    const p = Math.min(1, Math.max(0, scrollY / Math.max(1, stop)));
    const c = at(p);
    root.style.setProperty('--np-p', p.toFixed(4));
    root.style.setProperty('--np-top', `rgb(${c.top})`);
    root.style.setProperty('--np-bot', `rgb(${c.bot})`);
    root.style.setProperty('--np-glow', c.glow.toFixed(3));
  };
  const ask = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  addEventListener('scroll', ask, { passive: true });
  addEventListener('resize', ask);
  update();

  // stars: drawn once per size, faded out by CSS as the night passes
  const cv = document.querySelector<HTMLCanvasElement>('.np-stars');
  const draw = () => {
    if (!cv) return;
    const d = Math.min(2, devicePixelRatio || 1), w = innerWidth, h = innerHeight;
    cv.width = w * d; cv.height = h * d;
    const x = cv.getContext('2d')!;
    x.scale(d, d);
    let s = 7;
    const r = () => ((s = (s * 16807) % 2147483647) / 2147483647);
    const n = Math.round((w * h) / 5200);
    for (let i = 0; i < n; i++) {
      const big = r() > 0.94;
      x.globalAlpha = 0.25 + r() * (big ? 0.7 : 0.45);
      x.fillStyle = r() > 0.85 ? '#F2D6C0' : '#E6ECFF';
      x.beginPath(); x.arc(r() * w, r() * h * 0.9, big ? 1.3 : 0.7, 0, Math.PI * 2); x.fill();
    }
  };
  draw();
  let rs: number | undefined;
  addEventListener('resize', () => { clearTimeout(rs); rs = window.setTimeout(draw, 200); });
</script>

<style>
  .np { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  .np-sky { position: absolute; inset: 0; background: linear-gradient(180deg, var(--np-top, #070B18) 0%, var(--np-top, #070B18) 35%, var(--np-bot, #070B18) 100%); }
  .np-stars { position: absolute; inset: 0; width: 100%; height: 100%; opacity: calc(1 - var(--np-p, 0) * 1.05); }
  .np-glow { position: absolute; inset: auto -20% -30% -20%; height: 70%;
    background: radial-gradient(50% 55% at 50% 100%, rgba(168, 98, 142, 1), rgba(120, 70, 130, .5) 40%, transparent 75%);
    opacity: var(--np-glow, 0); }

  /* phones: a line of light along the top that warms as the night passes */
  .np-line { display: none; }
  @media (max-width: 760px) {
    .np-line { display: block; position: fixed; top: 0; left: 0; height: 2px; z-index: 60; width: calc(var(--np-p, 0) * 100%);
      background: linear-gradient(90deg, var(--aqua), var(--mauve) 60%, var(--peach)); box-shadow: 0 0 12px rgba(242, 180, 140, .55); pointer-events: none; }
  }
</style>
