---
// Live Instagram feed on a horizontal slider.
// Connect it by pasting a Behold (behold.so) JSON feed link into site.json → instagramFeedUrl.
// The posts load in the visitor's browser, so new posts appear without rebuilding the site.
// Until it's connected, soft placeholder cards link to the profile.
import site from '../data/site.json';
const ig = site.socials.find((s) => s.label === 'Instagram')?.url ?? '';
const handle = ig.replace(/\/+$/, '').split('/').pop() ?? '';
const feed = (site as { instagramFeedUrl?: string }).instagramFeedUrl ?? '';
---
<div class="strip ig-strip" tabindex="0" aria-label="Latest Instagram posts" data-feed={feed} data-ig={ig}>
  {Array.from({ length: 8 }, (_, i) => (
    <a class="note-card ph" href={ig || undefined} rel="noopener" style={`--i:${i}`} aria-label={`@${handle} on Instagram`}>
      <span class="ph-art" aria-hidden="true"></span>
      <span class="cap"><b>@{handle}</b>{feed ? 'Loading…' : 'On Instagram'}</span>
    </a>
  ))}
</div>
<script>
  type Post = { permalink: string; mediaType?: string; mediaUrl?: string; thumbnailUrl?: string; caption?: string; prunedCaption?: string; sizes?: Record<string, { mediaUrl?: string }> };
  document.querySelectorAll<HTMLElement>('.ig-strip[data-feed]').forEach(async (strip) => {
    const url = strip.dataset.feed;
    if (!url) return;
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const posts: Post[] = (Array.isArray(data) ? data : data.posts ?? []).slice(0, 12);
      if (!posts.length) return;
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
      strip.innerHTML = posts.map((p) => {
        const img = p.sizes?.medium?.mediaUrl || p.sizes?.large?.mediaUrl || (p.mediaType === 'VIDEO' ? p.thumbnailUrl : p.mediaUrl) || p.thumbnailUrl || '';
        const cap = (p.prunedCaption || p.caption || '').split('\n')[0].slice(0, 60);
        return `<a class="note-card" href="${esc(p.permalink)}" target="_blank" rel="noopener">
          <img src="${esc(img)}" alt="${esc(cap || 'Instagram post')}" loading="lazy" decoding="async" />
          ${p.mediaType === 'VIDEO' ? '<span class="kind" aria-hidden="true">▶</span>' : p.mediaType === 'CAROUSEL_ALBUM' ? '<span class="kind" aria-hidden="true">❏</span>' : ''}
          <span class="cap">${esc(cap)}</span></a>`;
      }).join('');
    } catch {
      strip.querySelectorAll('.cap').forEach((c) => { const t = c.lastChild; if (t) t.textContent = 'On Instagram'; });
    }
  });
</script>
<style>
  .ph-art { display: block; aspect-ratio: 4 / 5; width: 100%; position: relative; overflow: hidden;
    background:
      radial-gradient(70% 50% at 50% 100%, rgba(127, 216, 240, .16), transparent 70%),
      radial-gradient(60% 50% at calc(20% + var(--i) * 9%) 30%, rgba(156, 134, 255, .18), transparent 70%),
      linear-gradient(180deg, #0B1230, #0A0B1C); }
  .ph-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, .06) 50%, transparent 70%); transform: translateX(-100%); animation: ph 3.2s ease-in-out infinite; animation-delay: calc(var(--i) * .2s); }
  @keyframes ph { to { transform: translateX(100%); } }
  .strip :global(.kind) { position: absolute; top: 12px; right: 12px; font-size: 13px; color: #fff; text-shadow: 0 1px 6px rgba(0, 0, 0, .6); }
  .strip :global(.cap) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
