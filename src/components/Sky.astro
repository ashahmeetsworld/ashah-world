---
// The world's establishing shot. "night" = city lights on water (hero),
// "dawn" = the sunrise at the end of the night drive (closing scene).
interface Props { variant?: 'night' | 'dawn'; id?: string; }
const { variant = 'night', id = 'sky' } = Astro.props;

// deterministic randomness so every build looks the same
let seed = variant === 'night' ? 7 : 19;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const W = 1600, H = 1000, HZ = variant === 'night' ? 700 : 640;

const stars = Array.from({ length: variant === 'night' ? 190 : 70 }, () => ({
  x: r() * W, y: Math.pow(r(), 1.5) * (HZ - 90),
  s: r() < 0.06 ? 1.9 : r() < 0.3 ? 1.2 : 0.7,
  o: 0.35 + r() * 0.65, tw: r() < 0.28, d: (r() * 6).toFixed(2),
}));

// skyline: hard above the line
const buildings: { x: number; w: number; h: number }[] = [];
if (variant === 'night') {
  let x = -20;
  while (x < W + 20) {
    const w = 24 + r() * 58;
    // the city sits on the right, under the moon; the left stays open sky for the words
    const centre = Math.exp(-Math.pow((x - 1300) / 230, 2));
    const h = x < 1000 ? 6 + r() * 22 : 24 + r() * 50 + centre * (110 + r() * 190);
    buildings.push({ x, w, h });
    x += w + (r() < 0.2 ? 6 + r() * 20 : 0);
  }
}
const windows: { x: number; y: number; c: string; f: boolean; d: string }[] = [];
for (const b of buildings) {
  for (let yy = HZ - b.h + 10; yy < HZ - 8; yy += 11) {
    for (let xx = b.x + 5; xx < b.x + b.w - 6; xx += 9) {
      if (r() < 0.16) windows.push({
        x: xx, y: yy,
        c: r() < 0.62 ? '#F2B48C' : r() < 0.6 ? '#7FD8F0' : '#E08C7E',
        f: r() < 0.08, d: (r() * 8).toFixed(2),
      });
    }
  }
}
// soft below the line: broken reflections
const ripples = Array.from({ length: 120 }, () => {
  const y = HZ + 8 + Math.pow(r(), 1.3) * (H - HZ - 10);
  const depth = (y - HZ) / (H - HZ);
  return { x: r() * W, y, w: 8 + r() * 40 * (1 + depth * 2), o: (0.12 + r() * 0.3) * (1 - depth * 0.6),
           c: r() < 0.6 ? '#F2B48C' : r() < 0.5 ? '#7FD8F0' : '#E08C7E', d: (r() * 5).toFixed(2) };
});
const moon = variant === 'night' ? { x: 940, y: 190, r: 44 } : { x: 800, y: HZ, r: 118 };
const moonPath = Array.from({ length: 34 }, (_, i) => {
  const t = i / 33; const y = HZ + 6 + Math.pow(t, 1.4) * (H - HZ - 6);
  const spread = 14 + t * 150;
  return { x: moon.x - spread / 2 + (r() - 0.5) * spread * 0.6, y, w: spread * (0.25 + r() * 0.6), o: 0.85 - t * 0.55, d: (r() * 4).toFixed(2) };
});
const palms = variant === 'dawn' ? [
  { x: 300, h: 330, lean: -18, s: 1 }, { x: 400, h: 240, lean: 14, s: .8 }, { x: 1230, h: 370, lean: 22, s: 1.05 }, { x: 1330, h: 270, lean: -10, s: .85 },
] : [];
---
<svg class={`sky sky-${variant}`} id={id} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    {variant === 'night' ? (
      <linearGradient id={`${id}-air`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#05081A" />
        <stop offset=".38" stop-color="#0D1A4A" />
        <stop offset=".58" stop-color="#22175A" />
        <stop offset=".64" stop-color="#3A1F66" />
      </linearGradient>
    ) : (
      <linearGradient id={`${id}-air`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0B0F2E" />
        <stop offset=".3" stop-color="#3A1F66" />
        <stop offset=".5" stop-color="#8A4C8E" />
        <stop offset=".6" stop-color="#E08C7E" />
        <stop offset=".66" stop-color="#F2B48C" />
      </linearGradient>
    )}
    <linearGradient id={`${id}-sea`} x1="0" y1="0" x2="0" y2="1">
      {variant === 'night'
        ? [<stop offset="0" stop-color="#1A1550" />, <stop offset=".25" stop-color="#0C1338" />, <stop offset="1" stop-color="#05081A" />]
        : [<stop offset="0" stop-color="#C0717C" />, <stop offset=".3" stop-color="#5A2E70" />, <stop offset="1" stop-color="#0B0F2E" />]}
    </linearGradient>
    <radialGradient id={`${id}-halo`} cx={moon.x} cy={moon.y} r={variant === 'night' ? 340 : 560} gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={variant === 'night' ? '#DDE8FF' : '#FFD9B0'} stop-opacity=".55" />
      <stop offset=".18" stop-color={variant === 'night' ? '#7FD8F0' : '#F2B48C'} stop-opacity=".22" />
      <stop offset=".5" stop-color={variant === 'night' ? '#3A1F66' : '#E08C7E'} stop-opacity=".12" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`${id}-disc`} cx=".42" cy=".4" r=".7">
      {variant === 'night'
        ? [<stop offset="0" stop-color="#FFFFFF" />, <stop offset=".7" stop-color="#EEF2FF" />, <stop offset="1" stop-color="#C9D6F5" />]
        : [<stop offset="0" stop-color="#FFF4E3" />, <stop offset=".6" stop-color="#FFD2A1" />, <stop offset="1" stop-color="#F2A27C" />]}
    </radialGradient>
    <clipPath id={`${id}-above`}><rect width={W} height={HZ} /></clipPath>
    <filter id={`${id}-soft`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.2" /></filter>
  </defs>

  <rect width={W} height={HZ + 2} fill={`url(#${id}-air)`} />

  <g class="stars">
    {stars.map((s) => (
      <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.s} fill="#fff" opacity={s.o.toFixed(2)}
        class={s.tw ? 'tw' : undefined} style={s.tw ? `animation-delay:-${s.d}s` : undefined} />
    ))}
  </g>

  <g class="light">
    <circle class="breathe" cx={moon.x} cy={moon.y} r={variant === 'night' ? 340 : 560} fill={`url(#${id}-halo)`} />
    {variant === 'dawn' && (
      <g clip-path={`url(#${id}-above)`}>
        <circle cx={moon.x} cy={moon.y} r={moon.r} fill={`url(#${id}-disc)`} />
        {[0, 1, 2, 3].map((i) => (
          <rect x={moon.x - moon.r - 4} y={HZ - 18 - i * 17} width={moon.r * 2 + 8} height={3 + i * 0.6} fill="#E08C7E" opacity=".9" />
        ))}
      </g>
    )}
    {variant === 'night' && <circle cx={moon.x} cy={moon.y} r={moon.r} fill={`url(#${id}-disc)`} />}
  </g>

  {variant === 'dawn' && (
    <path d={`M0 ${HZ} L0 ${HZ - 30} C 160 ${HZ - 90}, 300 ${HZ - 50}, 420 ${HZ - 72} S 600 ${HZ - 20}, 680 ${HZ} Z M1600 ${HZ} L1600 ${HZ - 50} C 1450 ${HZ - 110}, 1300 ${HZ - 40}, 1180 ${HZ - 60} S 1000 ${HZ - 10}, 930 ${HZ} Z`} fill="#2A1A4E" opacity=".85" />
  )}

  {variant === 'night' && (
    <g class="city">
      {buildings.map((b) => <rect x={b.x.toFixed(1)} y={(HZ - b.h).toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} fill="#060A1C" />)}
      {buildings.filter((_, i) => i % 7 === 3).map((b) => (
        <rect x={(b.x + b.w / 2 - 1).toFixed(1)} y={(HZ - b.h - 26).toFixed(1)} width="2" height="26" fill="#060A1C" />
      ))}
      {windows.map((w) => (
        <rect x={w.x.toFixed(1)} y={w.y.toFixed(1)} width="3.4" height="4.4" fill={w.c} opacity=".85"
          class={w.f ? 'flick' : undefined} style={w.f ? `animation-delay:-${w.d}s` : undefined} />
      ))}
      {buildings.filter((_, i) => i % 11 === 5).map((b) => (
        <circle class="beacon" cx={(b.x + b.w / 2).toFixed(1)} cy={(HZ - b.h - 26).toFixed(1)} r="2.4" fill="#E04BAE" />
      ))}
    </g>
  )}

  <rect y={HZ} width={W} height={H - HZ} fill={`url(#${id}-sea)`} />
  <rect y={HZ} width={W} height="1.2" fill={variant === 'night' ? '#7FD8F0' : '#FFE3C4'} opacity=".35" />

  {variant === 'night' && (
    <g opacity=".22" filter={`url(#${id}-soft)`}>
      {buildings.map((b) => <rect x={b.x.toFixed(1)} y={HZ} width={b.w.toFixed(1)} height={(b.h * 0.55).toFixed(1)} fill="#020410" />)}
    </g>
  )}

  <g class="ripples">
    {variant === 'night' && ripples.map((p) => (
      <rect class="rip" x={p.x.toFixed(1)} y={p.y.toFixed(1)} width={p.w.toFixed(1)} height="1.6" rx=".8" fill={p.c} opacity={p.o.toFixed(2)} style={`animation-delay:-${p.d}s`} />
    ))}
    {moonPath.map((p) => (
      <rect class="glint" x={p.x.toFixed(1)} y={p.y.toFixed(1)} width={p.w.toFixed(1)} height={(2 + (p.y - HZ) / 120).toFixed(1)} rx="1"
        fill={variant === 'night' ? '#EAF1FF' : '#FFE0BC'} opacity={p.o.toFixed(2)} style={`animation-delay:-${p.d}s`} />
    ))}
  </g>

  {variant === 'night' && (
    <g class="figure" transform={`translate(760 ${HZ + 70})`}>
      <rect x="-210" y="0" width="420" height="5" fill="#03050F" />
      <rect x="-190" y="5" width="4" height="60" fill="#03050F" />
      <rect x="186" y="5" width="4" height="60" fill="#03050F" />
      <path d="M0 -44 a5.6 5.6 0 1 1 0.01 0 Z" fill="#03050F" />
      <path d="M-6 -33 C -9 -20, -12 -8, -13 0 L 13 0 C 12 -8, 9 -20, 6 -33 Z" fill="#03050F" />
    </g>
  )}

  {palms.map((p) => {
    const top = { x: p.x + p.lean, y: HZ - p.h };
    const fronds = [-150, -115, -80, -45, -10, 20, 55].map((a, i) => {
      const rad = (a * Math.PI) / 180, L = (70 + (i % 3) * 18) * p.s;
      const ex = top.x + Math.cos(rad) * L, ey = top.y + Math.sin(rad) * L * 0.55 + L * 0.35;
      const mx = top.x + Math.cos(rad) * L * 0.5, my = top.y + Math.sin(rad) * L * 0.5 - 14 * p.s;
      return `M${top.x} ${top.y} Q ${mx} ${my} ${ex} ${ey} Q ${mx} ${my + 9 * p.s} ${top.x} ${top.y + 4}`;
    });
    return (
      <g fill="#0A0720">
        <path d={`M${p.x - 7 * p.s} ${HZ + 4} Q ${p.x + p.lean * 0.2} ${HZ - p.h * 0.5} ${top.x - 2} ${top.y} L ${top.x + 3} ${top.y} Q ${p.x + p.lean * 0.3 + 6} ${HZ - p.h * 0.5} ${p.x + 7 * p.s} ${HZ + 4} Z`} />
        {fronds.map((d) => <path d={d} />)}
      </g>
    );
  })}
</svg>

<style>
  .sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  @media (max-width: 760px) { .figure { display: none; } }
  .tw { animation: twinkle 4.6s ease-in-out infinite; }
  .flick { animation: flick 7s steps(1) infinite; }
  .beacon { animation: beacon 2.8s ease-in-out infinite; }
  .breathe { transform-box: fill-box; transform-origin: center; animation: breathe 9s ease-in-out infinite; }
  .rip { animation: drift 7s ease-in-out infinite alternate; }
  .glint { animation: glint 3.6s ease-in-out infinite alternate; }
  @keyframes twinkle { 0%, 100% { opacity: .15; } 50% { opacity: 1; } }
  @keyframes flick { 0%, 62% { opacity: .85; } 63%, 70% { opacity: .1; } 71% { opacity: .85; } }
  @keyframes beacon { 0%, 100% { opacity: .2; } 50% { opacity: 1; } }
  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.08); opacity: 1; } }
  @keyframes drift { from { transform: translateX(-10px); } to { transform: translateX(12px); } }
  @keyframes glint { from { transform: translateX(-6px); opacity: .25; } to { transform: translateX(7px); } }
</style>
