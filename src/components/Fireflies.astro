---
// Fireflies over a dark treeline: scattered at first, then pulsing in time.
let seed = 61;
const r = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const W = 1600, H = 900;
const flies = Array.from({ length: 70 }, () => ({ x: r() * W, y: 160 + r() * 560, s: 1.4 + r() * 2.2, d: (r() * 0.9).toFixed(2), dx: (r() * 30 - 15).toFixed(0), dy: (r() * 20 - 10).toFixed(0), wd: (5 + r() * 6).toFixed(1) }));
const trees = Array.from({ length: 46 }, (_, i) => ({ x: i * 36 + (r() - 0.5) * 20, h: 110 + r() * 170, w: 26 + r() * 22 }));
---
<svg class="ff" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="ff-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#05070F" />
      <stop offset=".6" stop-color="#140B22" />
      <stop offset="1" stop-color="#2A0F2A" />
    </linearGradient>
    <radialGradient id="ff-g"><stop offset="0" stop-color="#FFE3B8" /><stop offset=".35" stop-color="#F2B48C" stop-opacity=".7" /><stop offset="1" stop-color="#D82A99" stop-opacity="0" /></radialGradient>
  </defs>
  <rect width={W} height={H} fill="url(#ff-sky)" />
  <g class="flies">
    {flies.map((f) => (
      <g class="wander" style={`--dx:${f.dx}px;--dy:${f.dy}px;animation-duration:${f.wd}s`}>
        <circle class="flash" style={`animation-delay:${f.d}s`} cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={(f.s * 5).toFixed(1)} fill="url(#ff-g)" />
        <circle class="flash" style={`animation-delay:${f.d}s`} cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={(f.s * 0.6).toFixed(2)} fill="#FFF4E3" />
      </g>
    ))}
  </g>
  <g fill="#04050B">
    {trees.map((t) => <path d={`M${t.x} ${H} L${t.x} ${H - t.h * 0.25} L${t.x - t.w / 2} ${H - t.h * 0.25} L${t.x} ${H - t.h} L${t.x + t.w / 2} ${H - t.h * 0.25} L${t.x} ${H - t.h * 0.25} Z`} />)}
    <rect y={H - 60} width={W} height="60" />
  </g>
</svg>
<style>
  .ff { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .wander { animation: wander 8s ease-in-out infinite alternate; }
  @keyframes wander { to { transform: translate(var(--dx), var(--dy)); } }
  /* every fly shares one 3.2s beat, offset slightly at first: the forest falls into rhythm */
  .flash { animation: flash 3.2s ease-in-out infinite; opacity: .15; }
  @keyframes flash { 0%, 60%, 100% { opacity: .12; } 70% { opacity: 1; } 80% { opacity: .5; } }
</style>
