---
// Social links as icons. Add/remove profiles in src/data/site.json → socials.
import site from '../data/site.json';
interface Props { size?: number }
const { size = 20 } = Astro.props;
const socials = site.socials.filter((s) => s.url);
const key = (l: string) => l.toLowerCase();
---
{socials.length > 0 && (
  <ul class="soc" aria-label="Social profiles">
    {socials.map((s) => (
      <li>
        <a href={s.url} rel="noopener" target="_blank" aria-label={s.label} title={s.label}>
          <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            {key(s.label) === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" /></>)}
            {key(s.label) === 'tiktok' && (<path d="M14 3v11.2a3.8 3.8 0 1 1-3.8-3.8M14 3c.4 2.6 2.2 4.5 5 4.8" />)}
            {key(s.label) === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.2v.1M11.5 17v-6.5M11.5 13.2c0-1.6 1.2-2.7 2.6-2.7s2.4 1 2.4 2.7V17" /></>)}
            {key(s.label) === 'discord' && (<path d="M8 7.5c2.6-.8 5.4-.8 8 0M7.5 16.5c2.9 1 6.1 1 9 0M7 7.8 5 15c1.3 1 2.6 1.6 4 2l.8-1.6M17 7.8l2 7.2c-1.3 1-2.6 1.6-4 2l-.8-1.6M9.6 12.6h.1M14.3 12.6h.1" />)}
            {!['instagram', 'tiktok', 'linkedin', 'discord'].includes(key(s.label)) && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" /></>)}
          </svg>
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .soc { list-style: none; padding: 0; margin: 0; display: flex; gap: 10px; }
  .soc a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink-2); transition: color .3s, border-color .3s, box-shadow .4s, transform .3s; }
  .soc a:hover, .soc a:focus-visible { color: var(--peach); border-color: var(--peach); box-shadow: 0 0 22px rgba(242, 180, 140, .35); transform: translateY(-2px); outline: none; }
</style>
